---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import KnowledgeBar from '../components/KnowledgeBar.astro';
import { knowledgeContext } from '../data/knowledge.ts';
import { contactEmail, externalLinks } from '../data/site.ts';
import '../styles/global.css';
import '../styles/site.css';

interface Breadcrumb {
  label: string;
  /** Site-relative path. Omit on the current page. */
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  pageType?: string;
  noindex?: boolean;
  /** Set for insight/blog posts — switches og:type to article and emits BlogPosting JSON-LD. */
  article?: {
    publishedTime: string;
    authorName: string;
    authorUrl?: string;
  };
  /** Trail from the home page to this page; emitted as BreadcrumbList JSON-LD. */
  breadcrumbs?: Breadcrumb[];
  /** Additional schema.org objects. Only facts that are visible on the page. */
  jsonLd?: Record<string, unknown>[];
  /** An above-the-fold image worth fetching before the stylesheet settles. */
  preloadImage?: { href: string; media?: string; type?: string };
}

const {
  title,
  description,
  pageType,
  noindex = false,
  article,
  breadcrumbs,
  jsonLd = [],
  preloadImage,
} = Astro.props;

const site = Astro.site ?? new URL('https://poesis.cloud');
const canonical = new URL(Astro.url.pathname, site).href;
const knowledge = knowledgeContext(Astro.url.pathname);
/**
 * An archived offer stays online for whoever follows an old link, but is no longer
 * offered to search engines: it would compete with the one service sold today.
 * `follow` keeps its links counted. Nothing in robots.txt hides these pages, or
 * a crawler could never read this directive.
 */
const indexable = !noindex && !knowledge.archive;
const conversionDescription = 'Poesis guides the agentic transformation of organizations, from one team to the whole enterprise, with SAF, its open-source Systemic Agentic Framework, as the method and the engine.';
/** Knowledge pages without their own description keep the wording they were published with. */
const knowledgeDescription = 'Poesis develops GSM specification content, SIE definition foundations, SIS contribution intake, local SAF controls, planned OIP workflows and early-stage SIM model work. Availability and integration are stated per scope.';
const resolvedDescription = description ?? (knowledge.inKnowledge ? knowledgeDescription : conversionDescription);
// On the conversion pages a title that already ends with the name does not repeat it. Knowledge pages keep their titles as published.
const fullTitle = !knowledge.inKnowledge && /(^|\s)Poesis$/.test(title) ? title : `${title} · Poesis`;
const ogImage = new URL('/og-default.png', site).href;
const socialImageAlt = 'Poesis: governed synthetic autopoiesis';

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Poesis',
  url: site.href,
  logo: new URL('/poesis-logo.png', site).href,
  slogan: 'Define the world in software; generate it.',
  email: contactEmail,
  sameAs: [externalLinks.linkedin, externalLinks.github],
};

const articleLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description: resolvedDescription,
      url: canonical,
      datePublished: article.publishedTime,
      image: ogImage,
      author: {
        '@type': 'Person',
        name: article.authorName,
        ...(article.authorUrl ? { url: article.authorUrl } : {}),
      },
      publisher: { '@type': 'Organization', name: 'Poesis', url: site.href },
    }
  : null;

const breadcrumbLd = breadcrumbs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ label: 'Poesis', href: '/' }, ...breadcrumbs].map((crumb, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: crumb.label,
        item: new URL(crumb.href ?? Astro.url.pathname, site).href,
      })),
    }
  : null;

const structuredData = [organizationLd, articleLd, breadcrumbLd, ...jsonLd.map((entry) => ({ '@context': 'https://schema.org', ...entry }))].filter(Boolean);
/** `<` never appears raw inside a JSON-LD script, whatever a description contains. */
const serialize = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#070a12" />
    <meta name="color-scheme" content="dark" />
    {/* Set before first paint: the compact menu is laid out folded from the start, so
        nothing moves when the menu script runs. Without scripts the links stay visible. */}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage.href} media={preloadImage.media} type={preloadImage.type} fetchpriority="high" />}
    <title>{fullTitle}</title>
    <meta name="description" content={resolvedDescription} />
    {indexable ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Poesis" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    {article && <meta property="article:published_time" content={article.publishedTime} />}
    {article && <meta property="article:author" content={article.authorName} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <meta name="generator" content={Astro.generator} />
    {structuredData.map((entry) => <script type="application/ld+json" set:html={serialize(entry)} />)}
    {/* Consent mode default + dataLayer stub. The gtag.js script itself is NOT
        loaded here — it is injected by ConsentBanner only after the user grants
        analytics consent. This guarantees "reject = zero GA cookies": with
        consent mode alone, gtag.js would still write the _ga cookie on load. */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });
      // Lazily inject the GA4 script + config. Called by ConsentBanner on grant.
      window.poesisLoadGA4 = function () {
        if (window.__poesisGA4Loaded) return;
        window.__poesisGA4Loaded = true;
        gtag('consent', 'update', {
          analytics_storage: 'granted',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied'
        });
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-KZGGY5D9GW';
        document.head.appendChild(s);
        gtag('js', new Date());
        // Pin the cookie to the parent domain so a single _ga cookie is shared
        // across poesis.cloud and docs.poesis.cloud (avoids duplicate same-name
        // host-only vs parent-domain cookies when both sites load the same ID).
        gtag('config', 'G-KZGGY5D9GW', { anonymize_ip: true, cookie_domain: 'poesis.cloud' });
      };
      // Delegated conversion events. The gtag stub only queues them in
      // dataLayer; they leave the browser if and when GA4 is loaded after
      // consent. `data-track` names one event of the measurement plan
      // (src/data/site.ts); `data-demo-cta` is kept for Knowledge pages.
      document.addEventListener('click', function (e) {
        var t = e.target && e.target.closest ? e.target : null;
        if (!t) return;
        var tracked = t.closest('[data-track]');
        if (tracked) {
          gtag('event', tracked.getAttribute('data-track'), {
            cta_id: tracked.getAttribute('data-track-id') || '',
            link_url: tracked.getAttribute('href') || '',
            page_path: location.pathname,
          });
        }
        var demo = t.closest('[data-demo-cta]');
        if (demo) {
          gtag('event', 'demo_cta_click', {
            cta_id: demo.getAttribute('data-demo-cta'),
            link_url: demo.getAttribute('href'),
            page_path: location.pathname,
          });
        }
      });
    </script>
  </head>
  <body data-page-type={pageType} data-area={knowledge.inKnowledge ? 'knowledge' : 'site'}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    {knowledge.inKnowledge && !knowledge.isHub && <KnowledgeBar archive={knowledge.archive} />}
    {/* Only Knowledge pages enter the search index: the search on /knowledge/ is a
        search of the corpus, and nothing outside it (conversion pages, bundled
        previews under public/) can surface in a result. */}
    <main id="main" data-pagefind-body={knowledge.inKnowledge ? '' : undefined}>
      {pageType && <span data-pagefind-meta="type" hidden>{pageType}</span>}
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
  </body>
</html>
