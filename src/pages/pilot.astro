---
/**
 * Pilot — what a first pilot is inside an agentic transformation.
 *
 * This address used to hold the catalog-driven brief builder for an OIP and SIE
 * evaluation. That tool is kept, unchanged, in Knowledge at /services/pilot.
 * The page here describes the pilot Poesis runs today: step three of the
 * transformation method, on SAF.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
import { faqLd, pilotFaq } from '../data/faq.ts';
import { maturityLabel } from '../data/saf.ts';

const title = 'A first pilot of agentic transformation';
const description = 'What a first pilot with Poesis involves: an agreed scope and success criteria, a model of its roles and workflows, a run on SAF under human review, and an evidence review that supports a decision.';

const involves = [
  { title: 'An agreed scope', body: 'One team, function or process, with the people who own it. What is in, what is out, and who decides.' },
  { title: 'Success criteria, written first', body: 'The observable results that would make the pilot worth extending, fixed before the work starts.' },
  { title: 'A model of the perimeter', body: 'Its roles, responsibilities, workflows and artifacts, and the limits of what is delegated to agents.' },
  { title: 'A run on SAF', body: 'The model at work on real tasks, each step resolved, checked and recorded, with people reviewing at the points you chose.' },
  { title: 'An evidence review', body: 'What the artifacts and journals show against the criteria, including what did not work.' },
  { title: 'A decision', body: 'Extend the scope, adjust the model, or stop. All three are legitimate outcomes.' },
];

const isNot = [
  'A software trial or a subscription: SAF is a pair of open-source plugins, and Poesis hosts nothing.',
  `Production use: SAF is in ${maturityLabel.toLowerCase()}, and a pilot runs under human review.`,
  'A fixed package: duration, access, responsibilities and commercial terms are agreed for each engagement.',
  'A promise of results: the pilot exists to find out, on evidence, whether to go further.',
];
---
<BaseLayout
  title={title}
  description={description}
  pageType="Pilot"
  breadcrumbs={[{ label: 'Transformation', href: '/transformation/' }, { label: 'Pilot' }]}
  jsonLd={[faqLd(pilotFaq)]}
>
  <section class="intro">
    <div class="container">
      <ol class="crumbs" aria-label="Breadcrumb">
        <li><a href="/">Poesis</a></li>
        <li><a href="/transformation/">Transformation</a></li>
        <li aria-current="page">Pilot</li>
      </ol>
      <h1>A first pilot of agentic transformation.</h1>
      <p class="intro__lead">A pilot is the third step of the Poesis method: the model of one perimeter, run on SAF under human review, and judged on the evidence it produces. It is how a transformation starts small and earns its next step.</p>
      <div class="actions">
        <a class="btn btn-primary btn-lg" href="/contact/" data-track="business_contact_intent" data-track-id="pilot-intro">Discuss a pilot for your organization</a>
        <a class="btn btn-quiet" href="/transformation/#method">See the whole method</a>
      </div>
    </div>
  </section>

  <section class="band band--raised" aria-labelledby="involves-title">
    <div class="container">
      <div class="band-head">
        <h2 id="involves-title">What a pilot involves.</h2>
      </div>
      <dl class="spec">
        {involves.map((item) => (
          <div>
            <dt>{item.title}</dt>
            <dd>{item.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="band" aria-labelledby="not-title">
    <div class="container">
      <div class="band-head">
        <h2 id="not-title">What a pilot is not.</h2>
      </div>
      <ul class="plain-list prose-narrow">
        {isNot.map((item) => <li>{item}</li>)}
      </ul>
      <p class="fineprint">Looking for the earlier Poesis Pilot brief builder, for an evaluation of OIP and SIE? It is kept, as published, in the <a href="/services/pilot">Knowledge archive</a>.</p>
    </div>
  </section>

  <section class="band band--raised" id="faq" aria-labelledby="faq-title">
    <div class="container">
      <div class="band-head">
        <h2 id="faq-title">Questions about a first pilot.</h2>
      </div>
      <Faq items={pilotFaq} />
    </div>
  </section>

  <section class="closing" aria-labelledby="closing-title">
    <div class="container">
      <h2 id="closing-title">Tell us the perimeter you would start with.</h2>
      <p>A few lines are enough: the team or process, what hurts in it today, and what you would want to see at the end of a pilot.</p>
      <div class="actions">
        <a class="btn btn-primary btn-lg" href="/contact/" data-track="business_contact_intent" data-track-id="pilot-closing">Discuss a pilot for your organization</a>
        <a class="btn btn-quiet" href="/case-studies/">How pilots are documented</a>
      </div>
    </div>
  </section>
</BaseLayout>
