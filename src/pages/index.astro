---
/**
 * Home — sells one thing: the agentic transformation of an organization, guided
 * by Poesis. Its first job is a qualified conversation with a decision-maker.
 * SAF is shown as what the method runs on, and as the way in for developers,
 * without competing with that first job. Every product statement comes from
 * src/data/saf.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import ProductPanel from '../components/ProductPanel.astro';
import Faq from '../components/Faq.astro';
import { faqLd, homeFaq } from '../data/faq.ts';
import { evidenceKinds, publishedCaseStudies } from '../data/case-studies.ts';
import { maturityLabel, latestPreRelease, safProducts, safLinks, supportedHost } from '../data/saf.ts';
import { deliverables, methodSteps, scopes } from '../data/method.ts';
import { externalLinkAttributes, offerName } from '../data/site.ts';
import { formatDate } from '../data/format.ts';

const ledger = [
  {
    pain: 'AI experiments do not become an operating model',
    approach: 'Tasks and responsibilities are written as workflows: who acts, in what order, producing which artifact. The harness resolves the next eligible step from that definition and from what has already been recorded.',
    value: 'A way of working you can run again, hand over and improve, in place of a collection of prompts.',
  },
  {
    pain: 'Teams lose context at every handoff',
    approach: 'Each step writes one artifact of a declared kind, checked against its schema and committed to Git. The next agent or person starts from that artifact, not from a chat history.',
    value: 'Handoffs that carry their own record.',
  },
  {
    pain: 'Automation without control creates risk',
    approach: 'Agents write only where their grants allow, workflows name the points where a person reviews, and harness calls are journaled. In the alpha, the harness does not yet authenticate who approved.',
    value: 'Delegation with a boundary you can read, and a plain statement of what is not enforced yet.',
  },
  {
    pain: 'Scaling relies on tribal knowledge',
    approach: 'Roles, instructions, skills and model profiles are versioned files in a repository. A second team installs the same organization and adapts it.',
    value: 'Know-how that is reviewed, versioned and reusable.',
  },
  {
    pain: 'The organization changes faster than its processes',
    approach: 'Because the organization is declared in files, a change is a reviewed commit: scoped, reversible, and tried on one perimeter before the next.',
    value: 'Evolution by iteration, one perimeter at a time.',
  },
];

const qualities = [
  {
    name: 'Governed',
    why: 'Work advances through declared workflows. Each step is resolved from configuration and recorded outcomes, not improvised by the model.',
    limit: 'The harness governs what passes through it. Work done outside a governed workspace is outside its control.',
  },
  {
    name: 'Local-first',
    why: 'It runs on your own checkouts, in the agent host you already use. There is no Poesis-hosted service to adopt.',
    limit: 'Models are called through your agent host under its own terms. SAF does not change where that host sends data.',
  },
  {
    name: 'Composable',
    why: 'The harness knows no methodology. An organization is a set of files (agents, workflows, instructions, skills, contracts) that you can replace or write yourself.',
    limit: 'One organization ships today. Writing your own means following the harness contracts in the repository.',
  },
  {
    name: 'Inspectable',
    why: 'Every instruction, workflow and contract is a readable file, and harness calls are written to per-session journals.',
    limit: 'Journals cover the calls the harness captured, not everything a model did or reasoned.',
  },
  {
    name: 'Git-backed',
    why: 'Validated writes are committed step by step in your repository. History, diff and revert work as they do for code.',
    limit: 'It needs Git 2.38 or later and a Git identity in the workspace.',
  },
  {
    name: 'Human-supervised',
    why: 'Workflows name the points where a person reviews and decides. Agents propose; people advance.',
    limit: 'Authenticated human approval is planned, not shipped. Today the gate is a step in the workflow, not a verified signature.',
  },
  {
    name: 'Extensible',
    why: 'Host bindings are separate adapters, each with its own specification. A new host is added beside the core, not inside it.',
    limit: `One adapter exists today, for ${supportedHost.name}. Other hosts are a direction, not a supported integration.`,
  },
];

const description = 'Poesis helps you transform a team, a function or your whole organization into a governed agentic organization, with SAF, its open-source Systemic Agentic Framework, as the method and the engine.';
const heroSources = [{ src: '/hero/seed.webm', type: 'video/webm' }, { src: '/hero/seed.mp4', type: 'video/mp4' }];
---
<BaseLayout
  title="Agentic transformation for organizations, built on open-source SAF"
  description={description}
  pageType="Home"
  preloadImage={{ href: '/hero/seed-poster.webp', media: '(min-width: 1100px)', type: 'image/webp' }}
  jsonLd={[
    { '@type': 'WebSite', name: 'Poesis', url: 'https://poesis.cloud/', description },
    faqLd(homeFaq),
  ]}
>
  <section class="hero-seed" aria-labelledby="hero-title">
    <div class="hero-seed__media" aria-hidden="true">
      {/* Below 1100px this stage is not displayed, so the picture is offered only above it: the
          image itself is an empty pixel, and a phone fetches nothing here. */}
      <picture>
        <source media="(min-width: 1100px)" srcset="/hero/seed-poster.webp" type="image/webp" width="1280" height="720" />
        <img class="hero-seed__poster" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" width="1280" height="720" alt="" decoding="async" fetchpriority="high" />
      </picture>
      <video
        class="hero-seed__video"
        autoplay
        muted
        loop
        playsinline
        preload="none"
        width="1280"
        height="720"
        tabindex="-1"
        disablepictureinpicture
        data-sources={JSON.stringify(heroSources)}
      ></video>
    </div>
    <div class="container hero-seed__content">
      <p class="hero-seed__kicker">{offerName}, by Poesis</p>
      <h1 id="hero-title">
        Generate easily and rapidly a seed of an agentic organisation mirroring yours to automatize.
        <span class="hero-seed__turn">Plant it, and watch it to produce and evolve.</span>
      </h1>
      <p class="hero-seed__lead">Poesis turns the workflows, knowledge and governance of your organization into <strong>a working organization of AI agents</strong>. Start with one team, function or process: your people keep the decisions, and a governed pilot shows what works before you scale.</p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href="/contact/" data-track="business_contact_intent" data-track-id="home-hero">Discuss your transformation</a>
        <a class="btn btn-quiet" href="/open-source/" data-track="developer_docs_click" data-track-id="home-hero">Explore SAF open source</a>
      </div>
      <p class="hero-actions__note">Built on SAF, our open-source Systemic Agentic Framework. You talk to the people who build it.</p>
      {/* Below 1100px there is no room for the film beside the words: the same picture is shown as a still, with its legend. */}
      <img class="hero-figure" src="/hero/seed-poster-portrait.webp" width="720" height="900" loading="lazy" decoding="async" alt="Diagram: a strand of DNA planted in the ground grows into a tree of AI agents. People review the work at gates on its branches, and checked documents leave its tips." />
      <ul class="hero-key" aria-label="Legend: a seed grows into an organization of AI agents, reviewed by people, producing checked outputs">
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="12" rx="4.6" ry="7" fill="#e6fbff" /></svg>
          <span><strong>Seed</strong> a model of your organization</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="7.5" fill="none" stroke="#38bdf8" stroke-width="2" /><circle cx="12" cy="12" r="3.2" fill="#e6fbff" /></svg>
          <span><strong>AI agents</strong> each with a role</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.5" fill="none" stroke="#a5b4fc" stroke-width="2" /><circle cx="12" cy="9.5" r="2.6" fill="#e4e8ff" /><path d="M7 17.6a5 5 0 0 1 10 0z" fill="#e4e8ff" /></svg>
          <span><strong>People</strong> review at the gates</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="3.5" width="12" height="17" rx="1" fill="none" stroke="#e6fbff" stroke-width="1.8" /><path d="m9 12.4 2.2 2.4 3.9-5" fill="none" stroke="#99f6e4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span><strong>Outputs</strong> checked and recorded</span>
        </li>
      </ul>
    </div>
    <button class="hero-seed__toggle" type="button" hidden>Pause background animation</button>
  </section>

  <section class="band" id="why" aria-labelledby="why-title">
    <div class="container">
      <div class="band-head">
        <h2 id="why-title">Agents are easy to add. An organization that works with them is not.</h2>
        <p>Most difficulties with AI at work are organizational: who is responsible, what is handed over, who decides. These are the ones a transformation with Poesis addresses, and how SAF makes each of them explicit.</p>
      </div>
      <div class="ledger__head" aria-hidden="true">
        <span>What goes wrong</span>
        <span>What SAF makes explicit</span>
        <span>What you get</span>
      </div>
      <ul class="ledger">
        {ledger.map((row) => (
          <li class="ledger__row">
            <div>
              <p class="ledger__label">What goes wrong</p>
              <h3>{row.pain}</h3>
            </div>
            <div>
              <p class="ledger__label">What SAF makes explicit</p>
              <p>{row.approach}</p>
            </div>
            <div>
              <p class="ledger__label">What you get</p>
              <p class="ledger__value">{row.value}</p>
            </div>
          </li>
        ))}
      </ul>

      <ol class="flow" aria-label="From your organization to its governed evolution">
        <li><strong>Your organization</strong>The team, function or enterprise as it works today.</li>
        <li><strong>Agentic seed</strong>Its roles, responsibilities and workflows, written down.</li>
        <li><strong>Governed workflows</strong>Agents carry out steps the harness resolves and checks.</li>
        <li class="flow__gov"><strong>Human review</strong>People decide at the points the workflow names.</li>
        <li><strong>Learning and evolution</strong>Evidence from the work changes the seed.</li>
      </ol>
      <p class="flow__loop">The last step feeds the second: what the work teaches is written back into the seed, and the cycle starts again on a firmer base.</p>

      <div class="actions">
        <a class="btn btn-primary" href="/contact/" data-track="business_contact_intent" data-track-id="home-why">Map a first workflow with us</a>
        <a class="btn btn-quiet" href="/transformation/">How an engagement works</a>
      </div>
    </div>
  </section>

  <section class="band band--raised" id="method" aria-labelledby="method-title">
    <div class="container">
      <div class="band-head">
        <h2 id="method-title">Five steps, on a scope you choose.</h2>
        <p>The method is the same for one process or a whole enterprise. It is indicative: scope, pace and terms are agreed for each engagement.</p>
      </div>
      <ol class="steps steps--five">
        {methodSteps.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.summary}</p>
          </li>
        ))}
      </ol>
      <div class="split">
        <div>
          <h3>Where it can start</h3>
          <ul class="chips">
            {scopes.map((scope) => <li>{scope}</li>)}
          </ul>
        </div>
        <div>
          <h3>What an engagement may produce</h3>
          <ul class="plain-list">
            {deliverables.map((item) => <li>{item}</li>)}
          </ul>
          <p class="fineprint">Which of these apply, and in what depth, depends on the scope agreed. None is a fixed package or a committed timeline.</p>
        </div>
      </div>
      <div class="actions">
        <a class="btn btn-ghost" href="/how-it-works/">See how it works, step by step</a>
        <a class="btn btn-quiet" href="/contact/" data-track="business_contact_intent" data-track-id="home-method">Discuss your transformation</a>
      </div>
    </div>
  </section>

  <section class="band" id="strengths" aria-labelledby="strengths-title">
    <div class="container">
      <div class="band-head">
        <h2 id="strengths-title">Seven properties, each with its limit.</h2>
        <p>What makes the method dependable is in the framework itself. Each property below states what it gives you and where, in the current alpha, it stops.</p>
      </div>
      <dl class="qualities">
        {qualities.map((quality) => (
          <div class="quality">
            <dt>{quality.name}</dt>
            <dd>
              {quality.why}
              <p class="quality__limit"><b>Limit today.</b> {quality.limit}</p>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="band band--raised" id="saf" aria-labelledby="saf-title">
    <div class="container">
      <div class="band-head">
        <h2 id="saf-title">Built on SAF, an open-source framework you can inspect.</h2>
        <p>SAF, the Systemic Agentic Framework, is what the method runs on. Its code, specifications and releases are public: you can read all of it before you talk to us, and your teams can use it without us.</p>
      </div>
      <div class="products">
        {safProducts.map((product) => <ProductPanel product={product} trackId="home-saf" />)}
      </div>
      <p class="fineprint">{maturityLabel}: the latest pre-release of both products is {latestPreRelease.version}, published on {formatDate(latestPreRelease.publishedOn)}. They are plugins for an agent host, not a hosted service, and run on {supportedHost.name} only today. That is why an engagement starts with a pilot under human review.</p>
      <div class="actions">
        <a class="btn btn-ghost" href="/open-source/" data-track="developer_docs_click" data-track-id="home-saf">Explore SAF open source</a>
        <a class="btn btn-quiet" href={safLinks.repositories} {...externalLinkAttributes} data-track="developer_repo_click" data-track-id="home-saf-star">Star the repositories on GitHub</a>
      </div>
    </div>
  </section>

  {publishedCaseStudies.length > 0 && (
    <section class="band" id="proof" aria-labelledby="proof-title">
      <div class="container">
        <div class="band-head">
          <h2 id="proof-title">Real work. Verifiable learning.</h2>
          <p>Each case states whether it is a demonstration, a pilot or an operational deployment, and links to evidence you can inspect.</p>
        </div>
        <ul class="case-list">
          {publishedCaseStudies.map((study) => (
            <li class="case-card">
              <span class="status status--verified">{evidenceKinds[study.kind].label}</span>
              <h3><a href={`/case-studies/${study.slug}/`}>{study.title}</a></h3>
              <p>{study.summary}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="band" id="faq" aria-labelledby="faq-title">
    <div class="container">
      <div class="band-head">
        <h2 id="faq-title">Questions people ask first.</h2>
      </div>
      <Faq items={homeFaq} />
    </div>
  </section>

  <ContactSection source="home" title="Let's explore your first agentic use case.">
    <p>Tell us the scope you have in mind and what you would want to see change.</p>
  </ContactSection>
</BaseLayout>

<script is:inline>
  // Links published before the redesign pointed at sections of the former
  // homepage, now the platform overview of the Knowledge corpus. A fragment
  // never reaches a server, so only the page itself can forward it.
  // An anchor unknown to this page is looked up in the overview and followed only
  // if it exists there, so no old link is lost and no stray fragment misleads.
  (function () {
    var hash = location.hash.slice(1);
    if (!hash || !/^[A-Za-z0-9_-]+$/.test(hash) || document.getElementById(hash) || !window.fetch) return;
    fetch('/knowledge/platform/')
      .then(function (response) { return response.ok ? response.text() : ''; })
      .then(function (html) { if (html.indexOf('id="' + hash + '"') > -1) location.replace('/knowledge/platform/#' + hash); })
      .catch(function () { /* the home page stays as it is */ });
  })();

  // Background film. The still picture is the default for everyone. The film is
  // fetched only where it has room beside the words (1100px and more), when the
  // visitor has not asked for reduced motion or reduced data, and it can be paused
  // at any time. Below that width the same picture is shown as a still in the page.
  (function () {
    var video = document.querySelector('.hero-seed__video');
    var toggle = document.querySelector('.hero-seed__toggle');
    if (!video || !toggle || typeof video.play !== 'function') return;
    var wide = window.matchMedia('(min-width: 1100px)');
    var still = window.matchMedia('(prefers-reduced-motion: reduce)');
    var connection = navigator.connection || {};
    var lean = Boolean(connection.saveData) || /(^|-)2g$/.test(connection.effectiveType || '') || window.matchMedia('(prefers-reduced-data: reduce)').matches;
    var choice = null;
    try { choice = sessionStorage.getItem('poesis-hero-film'); } catch (error) { /* storage unavailable */ }
    var loaded = false;

    function label(paused) { toggle.textContent = paused ? 'Play background animation' : 'Pause background animation'; }
    function load() {
      if (loaded) return;
      loaded = true;
      JSON.parse(video.getAttribute('data-sources')).forEach(function (source) {
        var element = document.createElement('source');
        element.src = source.src;
        element.type = source.type;
        video.appendChild(element);
      });
      video.addEventListener('playing', function () { video.classList.add('is-playing'); });
      video.load();
    }
    function play() {
      load();
      var started = video.play();
      if (started && started.catch) started.catch(function () { label(true); });
    }
    function apply() {
      var allowed = wide.matches && !still.matches && !lean;
      toggle.hidden = !allowed;
      if (!allowed) { video.pause(); video.classList.remove('is-playing'); return; }
      if (choice === 'paused') { label(true); return; }
      label(false);
      play();
    }
    toggle.addEventListener('click', function () {
      var pausing = loaded && !video.paused;
      choice = pausing ? 'paused' : 'playing';
      try { sessionStorage.setItem('poesis-hero-film', choice); } catch (error) { /* storage unavailable */ }
      if (pausing) video.pause(); else play();
      label(pausing);
    });
    wide.addEventListener('change', apply);
    still.addEventListener('change', apply);
    apply();
  })();
</script>
