---
/**
 * Home — sells one thing: the agentic transformation of an organization, guided
 * by Poesis. Its first job is a conversation with a decision-maker; its second
 * is to send a developer to SAF. Six sections, a few hundred words.
 *
 * Direction decided by the team on 22 November 2026: the structure of concept B
 * (a short promise, the two paths early, a scene that reads from left to right)
 * with the identity of concept A (the dark ground, the serif, a discreet strand).
 *
 * Every statement about SAF is one its public repositories support: see
 * src/data/saf.ts. The page prints no count, no version and no licence name.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import DemoChat from '../components/DemoChat.astro';
import Icon from '../components/Icon.astro';
import { evidenceKinds, publishedCaseStudies } from '../data/case-studies.ts';
import { harness, maturityLabel, safLinks, supportedHost } from '../data/saf.ts';
import { contactEmail, externalLinkAttributes } from '../data/site.ts';
import { developerCta, navigationCta } from '../data/site-navigation.ts';

/** The title of the page and its H1, approved on 22 November 2026. Held word for word by a test. */
/** The promise of the hero. "governed AI" is set apart in the page; the title of the tab is the plain sentence. */
const heroTitle = 'Turn your organization into a governed AI operating model';
/** The two actions of the hero, as worded for it. The header keeps the action of the site, `navigationCta`. */
const heroCta = { href: navigationCta.href, label: 'Talk to Poesis' };
const heroDeveloperCta = { href: developerCta.href, label: 'Build with SAF' };
/** Three things the page goes on to show; each is a statement the SAF documentation supports. */
const heroPoints = [
  { icon: 'layers', text: 'Organize work with AI agents' },
  { icon: 'shield', text: 'Keep people in control' },
  { icon: 'check-badge', text: 'Trace every decision in Git' },
] as const;
const description = 'Poesis helps organizations adopt governed AI agents: a transformation service that starts with a focused pilot, built on SAF, its open-source framework.';

/** Three problems a decision-maker recognizes, each with what changes. Only what SAF ships today is on the right. */
const changes = [
  { pain: 'AI experiments that do not scale.', result: 'Start with one team or one workflow, on a frame built to extend.' },
  { pain: 'Agents without clear rules.', result: 'Roles, workflows and write rights are declared before an agent runs.' },
  { pain: 'Outputs no one can review.', result: 'Each step leaves a checked document in your Git. A person decides at the end of every workflow.' },
];

/** The four steps of an engagement. They describe a service Poesis leads, not something the software does alone. */
const growth = [
  { verb: 'Mirror', text: 'We map one scope with you: its roles, its workflows, its documents.' },
  { verb: 'Organize', text: 'That map becomes AI agents, each with a role, a workflow and a format to follow.' },
  { verb: 'Govern', text: 'The harness checks every write against the rules you declared. People hold the decisions.' },
  { verb: 'Evolve', text: 'Frictions are logged as the work runs, and you revise the organization under version control.' },
];

/** What "governed" stands on in SAF today. Each line stops where the check stops. */
const qualities = [
  { name: 'Explicit workflows', text: 'Who does what, and in which order, is written down before the work starts.' },
  { name: 'Checked artifacts', text: 'The harness validates each document against its declared schema, and nothing beyond it.' },
  { name: 'Human gates', text: 'Every workflow ends with a person who accepts, raises concerns or rejects.' },
  { name: 'Yours, in Git', text: 'The work is committed to your own repository. Poesis hosts nothing.' },
];
---
<BaseLayout
  title={heroTitle}
  description={description}
  pageType="Home"
  jsonLd={[{ '@type': 'WebSite', name: 'Poesis', url: 'https://poesis.cloud/', description }]}
>
  <section class="masthead" aria-labelledby="hero-title">
    <svg class="masthead__wave" viewBox="0 0 1440 300" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="hero-wave-line" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#2dd4bf" stop-opacity="0" />
          <stop offset=".3" stop-color="#2dd4bf" stop-opacity=".7" />
          <stop offset=".68" stop-color="#38bdf8" stop-opacity=".45" />
          <stop offset="1" stop-color="#38bdf8" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="hero-wave-fill" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="#2dd4bf" stop-opacity=".16" />
          <stop offset="1" stop-color="#2dd4bf" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path d="M0 150C210 60 420 70 650 160S1120 280 1440 130V300H0Z" fill="url(#hero-wave-fill)" />
      <path d="M0 150C210 60 420 70 650 160S1120 280 1440 130" fill="none" stroke="url(#hero-wave-line)" stroke-width="1.6" vector-effect="non-scaling-stroke" />
      <path d="M0 205C250 120 470 150 720 215S1160 290 1440 200" fill="none" stroke="url(#hero-wave-line)" stroke-width="1" opacity=".5" vector-effect="non-scaling-stroke" />
    </svg>
    <div class="container masthead__grid">
      <div class="masthead__words">
        <h1 id="hero-title">Turn your organization into a <span class="masthead__accent">governed AI</span> operating model.</h1>
        <p class="masthead__lead">Poesis helps organizations and developers design, govern and grow agentic systems around real work — with <strong>SAF</strong> at the core.</p>
        <div class="masthead__actions">
          <a class="btn btn-primary btn-lg" href={heroCta.href} data-track="business_contact_intent" data-track-id="home-hero">{heroCta.label} <Icon name="arrow-right" size={18} /></a>
          <a class="btn btn-ghost btn-lg" href={heroDeveloperCta.href} data-track="developer_docs_click" data-track-id="home-hero">{heroDeveloperCta.label} <svg class="masthead__code" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m16 18 6-6-6-6" /><path d="m8 6-6 6 6 6" /></svg></a>
        </div>
      </div>

      {/* Two scripted demonstrations, Build and Run, each with several cases. The visitor chooses a side first. Illustrative, and labelled so. */}
      <div class="masthead__demo">
        <DemoChat id="hero-demo" source="home" intro />
      </div>

      <ul class="masthead__points">
        {heroPoints.map((point) => <li><Icon name={point.icon} size={22} /> <span>{point.text}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="band" id="change" aria-labelledby="change-title">
    <div class="container">
      <div class="band-head">
        <h2 id="change-title">From AI experiments to work you can govern.</h2>
      </div>
      <ul class="changes">
        <li class="changes__head" aria-hidden="true">
          <span>Today</span>
          <span>With Poesis and SAF</span>
        </li>
        {changes.map((row) => (
          <li>
            <p class="changes__pain"><span class="changes__label">Today</span> {row.pain}</p>
            <p class="changes__result"><span class="changes__label">With Poesis and SAF</span> {row.result}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band band--raised" id="grow" aria-labelledby="grow-title">
    <div class="container">
      <div class="band-head">
        <h2 id="grow-title">How it grows.</h2>
        <p>Four steps of an engagement led by Poesis. Scope and pace are agreed for each one.</p>
      </div>
      <ol class="growth">
        {growth.map((step) => (
          <li>
            <h3>{step.verb}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band" id="paths" aria-labelledby="paths-title">
    <div class="container">
      <h2 class="sr-only" id="paths-title">Two ways to start</h2>
      <div class="paths">
        <article class="path">
          <p class="path__for">For your organization</p>
          <h3>Transform your organization</h3>
          <p>A service led by Poesis. It starts with a pilot on one team or one workflow, and you judge it on the work it produces.</p>
          <div class="path__actions">
            <a class="btn btn-primary" href={navigationCta.href} data-track="business_contact_intent" data-track-id="home-paths">{navigationCta.label}</a>
            <a class="btn btn-quiet" href="/transformation/" data-track="business_transformation_click" data-track-id="home-paths">See how an engagement works</a>
          </div>
        </article>
        <article class="path">
          <p class="path__for">For developers</p>
          <h3>Build with SAF</h3>
          <p>An open-source framework: a harness, and the organizations that run on it, installed as {supportedHost.name} plugins. {maturityLabel}.</p>
          <div class="path__actions">
            <a class="btn btn-ghost" href={developerCta.href} data-track="developer_docs_click" data-track-id="home-paths">{developerCta.label}</a>
            <ul class="path__links">
              <li><a href={safLinks.quickstart} {...externalLinkAttributes} data-track="developer_docs_click" data-track-id="home-paths-quickstart">Quickstart</a></li>
              <li><a href={safLinks.repositories} {...externalLinkAttributes} data-track="developer_repo_click" data-track-id="home-paths-repositories">Repositories</a></li>
              <li><a href={harness.contributing} {...externalLinkAttributes} data-track="developer_repo_click" data-track-id="home-paths-contributing">Contributing</a></li>
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="band band--raised" id="governed" aria-labelledby="governed-title">
    <div class="container">
      <div class="band-head">
        <h2 id="governed-title">Why governed matters.</h2>
      </div>
      <dl class="qualities">
        {qualities.map((quality) => (
          <div>
            <dt>{quality.name}</dt>
            <dd>{quality.text}</dd>
          </div>
        ))}
      </dl>
      <p class="fineprint">SAF is in {maturityLabel.toLowerCase()}. <a href="/developers/#status">Read what it does today, and where it stops</a>.</p>
    </div>
  </section>

  <section class="closing closing--home" id="evidence" aria-labelledby="evidence-title">
    <div class="container closing__split">
      <div>
        <h2 id="evidence-title">Evidence, then scale.</h2>
        {publishedCaseStudies.length > 0 ? (
          <ul class="case-list">
            {publishedCaseStudies.map((study) => (
              <li class="case-card">
                <span class="status status--verified">{evidenceKinds[study.kind].label}</span>
                <h3><a href={`/case-studies/${study.slug}/`}>{study.title}</a></h3>
                <p>{study.summary}</p>
              </li>
            ))}
          </ul>
        ) : (
          <p>A pilot is documented with the client’s approval: its scope, what was run, where people decided and what it could not show. No case is published yet. <a href="/case-studies/">See how a pilot is documented</a>.</p>
        )}
        <p>Until then, what you can check is public: <a href={safLinks.repositories} {...externalLinkAttributes} data-track="developer_repo_click" data-track-id="home-evidence">the code</a>, <a href={safLinks.limitations} {...externalLinkAttributes} data-track="developer_docs_click" data-track-id="home-evidence-limits">its known limits</a> and <a href={safLinks.docs} {...externalLinkAttributes} data-track="developer_docs_click" data-track-id="home-evidence-docs">its documentation</a>.</p>
      </div>
      <div class="closing__call">
        <p class="closing__question">Which team would you start with?</p>
        <a class="btn btn-primary btn-lg" href={navigationCta.href} data-track="business_contact_intent" data-track-id="home-closing">{navigationCta.label}</a>
        <p class="closing__mail">Or write to <a href={`mailto:${contactEmail}`} data-track="business_contact_intent" data-track-id="home-closing-email">{contactEmail}</a></p>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Links published before the redesign pointed at sections of the former
  // homepage, now the platform overview of the Knowledge corpus. A fragment
  // never reaches a server, so only the page itself can forward it.
  // An anchor unknown to this page is looked up in the overview and followed only
  // if it exists there, so no old link is lost and no stray fragment misleads.
  (function () {
    var hash = location.hash.slice(1);
    if (!hash || !/^[A-Za-z0-9_-]+$/.test(hash) || document.getElementById(hash) || !window.fetch) return;
    fetch('/knowledge/platform/')
      .then(function (response) { return response.ok ? response.text() : ''; })
      .then(function (html) { if (html.indexOf(' id="' + hash + '"') > -1) location.replace('/knowledge/platform/#' + hash); })
      .catch(function () { /* the home page stays as it is */ });
  })();
</script>
