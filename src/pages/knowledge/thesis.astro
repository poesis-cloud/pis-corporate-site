---
/**
 * The thesis — the research argument, thesis and "DNA" sections that the About page
 * carried until the SAF-centred redesign. The text is unchanged; only its address moved,
 * so that About can stay short and the argument stays whole inside Knowledge.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

/** The argument chain — curated order, one 'establishes' line per article; titles stay in sync with the collection. */
const movements: { label: string; title: string; intro: string; articles: { slug: string; establishes: string }[] }[] = [
  {
    label: 'I',
    title: 'The inversion — where the intent comes from',
    intro: 'Classical systemics describes systems after the fact, so governance audits the past. The research began by inverting that.',
    articles: [
      {
        slug: 'the-generative-inversion',
        establishes: 'Make the definition primary and generative — the definition generates and governs the running thing, and the system becomes self-correcting rather than merely documented.',
      },
      {
        slug: 'definition-versus-description',
        establishes: 'The old opposition dissolves: definition makes observation intelligible; description makes definition corrigible. The regulation loop systemics always drew becomes operable.',
      },
      {
        slug: 'standardizing-the-think-layer',
        establishes: 'OpenTelemetry gave the RUN layer a neutral standard; the definitions those runtimes enforce — the THINK layer — still have none. That missing standard is what GSM specifies.',
      },
    ],
  },
  {
    label: 'II',
    title: 'The generative era — why now',
    intro: 'Generative AI did not create the definitional problem. It made ignoring it untenable — and solving it tractable.',
    articles: [
      {
        slug: 'as-probabilistic-as-human-intelligence',
        establishes: 'Probabilistic reasoning is not a defect to repair — human intelligence is probabilistic too. Humanity\u2019s remedy was never determinism; it was methodology and institutions. Machine reasoners should inherit both.',
      },
      {
        slug: 'governance-owns-the-concerns',
        establishes: 'A model can reason about a concern but cannot own one. Concerns are owned by stakeholders and carried by governance: the model proposes; the stack and the human dispose.',
      },
      {
        slug: 'why-poesis-matters-for-language-models',
        establishes: 'Do not ask the model to carry the organization in its weights. Governed context — which definition is in effect, who holds authority, what is permitted — beats bigger models for bounded enterprise work.',
      },
    ],
  },
  {
    label: 'III',
    title: 'The name — what it commits us to',
    intro: 'Poiesis (\u03C0\u03BF\u03AF\u03B7\u03C3\u03B9\u03C2) is the Greek word for bringing-forth. Maturana and Varela joined it to auto — self — and named the property that distinguishes living systems: producing the components that produce it.',
    articles: [
      {
        slug: 'governed-synthetic-autopoiesis',
        establishes: 'Generative AI made self-production cheap. What it did not make is the conserved organization that keeps self-production from becoming dissolution — the gap Poesis is named for.',
      },
      {
        slug: 'poesis-stack-as-research-system',
        establishes: 'The constitution generalizes beyond IT: open-ended research is not a workflow to accelerate but an institution to constitute. The first domain is a starting point, not a boundary.',
      },
    ],
  },
];

const posts = await getCollection('insights');
const postBySlug = new Map(posts.map((p) => [p.id.replace(/\.md$/, ''), p]));
---
<BaseLayout
  title="A thesis that refused to stay prose"
  description="Poesis researches explicit, versioned definitions as a basis for governance and AI-assisted work. Specification content, implementation foundations and planned integration remain distinct."
  pageType="Research"
>
  <section class="hero">
    <div class="container">
      <p class="motto">Define the world in software; generate it.</p>
      <h1>A thesis that refused to stay prose.</h1>
      <p class="lead">Poesis explores how explicit, versioned definitions can support human governance and AI-assisted work. Research and specification content, definition-management foundations and local agentic controls exist in distinct scopes. Continuous correspondence with operations, authenticated decisions and autonomous maintenance remain integration and research goals, not established outcomes.</p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <p class="eyebrow">Origin</p>
      <h2>It began with a blocker, not a product.</h2>
      <p class="lead">Poesis&rsquo;s founders spent their careers inside large IT estates: architecting them, governing them, selling and scaling the platforms they run on. Every estate ran on definitions — architectures, obligations, processes, constraints. And every estate kept them in prose. Wikis, slide decks, compliance spreadsheets, all decaying from the day they were written.</p>
      <p class="lead">The deeper observation was about automation. Prose is not just where definitions decay; it is where automation stops. A definition in a document can be read, debated, and forgotten. It cannot be executed, evaluated, or regenerated. Every automated system downstream needs a human to re-interpret the prose into code, configuration, and tickets, so the loop a viable system depends on — act, observe, correct — breaks at that boundary. Prose blocks autopoiesis: a system&rsquo;s capacity to produce and renew itself.</p>
      <p class="lead">Then generative AI made production cheap. Code, configuration, whole systems, brought forth on demand. The blocker turned existential: systems now produce the components that produce them, while the organization they must conserve still lives in documents nothing can act on. Out of that tension came the research. Out of the research, the project.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The research</p>
        <h2>The argument the enterprise is built on.</h2>
        <p class="lead">The position was built as a chain of published research notes, each establishing a step the stack now embodies. Read in order, they are the company&rsquo;s reasoning.</p>
      </div>
      {movements.map((m) => (
        <div class="movement">
          <h3><span class="movement-label" aria-hidden="true">{m.label}</span> {m.title}</h3>
          <p class="movement-intro">{m.intro}</p>
          <ol class="chain">
            {m.articles.map(({ slug, establishes }) => {
              const post = postBySlug.get(slug);
              return post ? (
                <li>
                  <a class="chain-title" href={`/insights/${slug}`}>{post.data.title}</a>
                  <p>{establishes}</p>
                </li>
              ) : null;
            })}
          </ol>
        </div>
      ))}
      <p style="margin-top:1.4rem"><a class="btn btn-ghost btn-sm service-link" href="/insights/research"><Icon name="book-open" /> Browse all research notes</a></p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <p class="eyebrow">The thesis</p>
      <h2>Definitions belong in software, not in prose.</h2>
      <p class="lead">The notes converge on one thesis. An organization&rsquo;s definitions must be typed, versioned, machine-operable objects: primary and generative, realized into systems that produce evidence, evidence that corrects the definitions. Not a model drawn after the fact. A loop operated continuously.</p>
      <p class="lead">The generative era sets the terms of that loop. Probabilistic reasoners, human or synthetic, are not made deterministic; they are governed. Concerns stay owned by human stakeholders and carried by explicit governance. The model proposes against governed context; deterministic evaluation and human disposition decide what becomes action.</p>
      <p class="lead">Held together, these commitments name what the enterprise exists to make real: <strong>governed synthetic autopoiesis</strong> — systems that continuously produce and renew their own organization without escaping the definitions, constraints, and human purposes that govern them. The theory is not ours to invent; it is systemics, from Beer&rsquo;s Viable System Model and von Bertalanffy&rsquo;s General System Theory to Wiener and Ashby&rsquo;s cybernetics and Maturana and Varela&rsquo;s autopoiesis. Our contribution is making that lineage executable.</p>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container">
      <p class="eyebrow">The DNA</p>
      <h2>What the thesis defines.</h2>
      <p class="lead">The thesis took organizational form. The stack, the domains, and the way Poesis runs itself are not adjacent to the research — they are what it defines.</p>
      <div class="proof-grid">
        <div class="proof-item">
          <span class="k">A standard, because prose is the blocker</span>
          <p>Definitions that machines must act on need a shared, vendor-neutral form. <a href="/solutions/gsm">GSM</a> is that THINK-layer standard: typed, versioned, evaluable, published openly and prepared for neutral stewardship.</p>
        </div>
        <div class="proof-item">
          <span class="k">An engine, because a loop must be operated</span>
          <p>Definitions, actions and observations can support a feedback loop when identity, authority and coverage are explicit. <a href="/solutions/sie">SIE</a> provides partial foundations; continuous appraisal and accepted operational reconciliation remain planned.</p>
        </div>
        <div class="proof-item">
          <span class="k">Institutions, because generative AI is probabilistic</span>
          <p><a href="/solutions/oip">OIP</a> and <a href="/solutions/saf">SAF</a> aim to make proposal and decision boundaries explicit. Workflow order and agent permissions do not alone establish authenticated human disposition.</p>
        </div>
        <div class="proof-item">
          <span class="k">Inspectability with explicit licenses</span>
          <p>GSM source content and research are distinct from formal publication. SAF harness, organization and workspace use Apache-2.0; the bridge and other products have their own license terms. Inspectability does not imply whole-stack open-source status or operational assurance.</p>
        </div>
        <div class="proof-item">
          <span class="k">Self-custody, because the claim binds the claimant</span>
          <p>Poesis development is a setting for bounded local workflow experiments. <a href="https://github.com/poesis-cloud" target="_blank" rel="noopener">Repository artifacts</a> can provide evidence, but they do not prove that every repository is governed through a complete operational loop.</p>
        </div>
      </div>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/knowledge/platform"><Icon name="compass" /> See what the research became</a>
        <a class="btn btn-ghost" href="/insights/research"><Icon name="book-open" /> Read the research</a>
        <a class="btn btn-ghost" href="/contact"><Icon name="message" /> Talk to us</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .movement {
    margin-top: 2.4rem;
  }
  .movement h3 {
    display: flex;
    align-items: baseline;
    gap: .7rem;
    margin: 0 0 .35rem;
  }
  .movement-label {
    font-family: var(--font-mono);
    font-size: .85em;
    color: var(--accent-ink);
  }
  .movement-intro {
    color: var(--ink-soft);
    max-width: 62ch;
    margin: 0 0 .4rem;
  }
  .chain {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    counter-reset: chain;
  }
  .chain li {
    position: relative;
    counter-increment: chain;
    padding: 0 0 1.3rem 2.9rem;
  }
  .chain li:last-child {
    padding-bottom: 0;
  }
  .chain li::before {
    content: counter(chain, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: .15rem;
    font-family: var(--font-mono);
    font-size: .8rem;
    color: var(--accent);
  }
  .chain li::after {
    content: "";
    position: absolute;
    left: .55rem;
    top: 1.55rem;
    bottom: .45rem;
    width: 1px;
    background: var(--line-strong);
  }
  .chain li:last-child::after {
    display: none;
  }
  .chain-title {
    font-weight: 600;
    color: var(--ink);
  }
  .chain li p {
    margin: .3rem 0 0;
    color: var(--muted);
    max-width: 68ch;
  }
</style>

