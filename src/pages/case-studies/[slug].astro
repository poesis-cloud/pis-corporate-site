---
/**
 * One case study.
 *
 * A page is generated for each record whose status is `published`. While none
 * is, a page is generated for the fictional example instead: it uses the same
 * template, carries a notice that it is fiction, reports no result, and is kept
 * out of search engines.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { evidenceKinds, fictionalNotice, publishedCaseStudies, shownExample, type CaseStudy, type IllustrativeExample } from '../../data/case-studies.ts';
import { formatDate } from '../../data/format.ts';
import { externalLinkAttributes } from '../../data/site.ts';

export function getStaticPaths() {
  return [
    ...publishedCaseStudies.map((study) => ({ params: { slug: study.slug }, props: { study } })),
    ...(shownExample ? [{ params: { slug: shownExample.slug }, props: { example: shownExample } }] : []),
  ];
}

interface Props {
  study?: CaseStudy;
  example?: IllustrativeExample;
}
const { study, example } = Astro.props;
const record = (study ?? example)!;
const kind = study ? evidenceKinds[study.kind] : null;
const sections: [string, string][] = [
  ['Context', record.context],
  ['Problem', record.problem],
  ['Scope', record.scope],
  ['Method', record.method],
  ['Agents and workflows', record.agentsAndWorkflows],
  ['Human controls', record.humanControls],
  ['Period', record.period],
  ['Limits', record.limits],
  ['Learnings', record.learnings],
  ['Next step', record.nextStep],
];
---
<BaseLayout
  title={record.title}
  description={record.summary}
  pageType="Case Study"
  noindex={!study}
  breadcrumbs={study ? [{ label: 'Case Studies', href: '/case-studies/' }, { label: record.title }] : undefined}
>
  <section class="intro intro--with-status">
    <div class="container">
      <ol class="crumbs" aria-label="Breadcrumb">
        <li><a href="/">Poesis</a></li>
        <li><a href="/case-studies/">{study ? 'Case Studies' : 'Documenting pilots'}</a></li>
        <li aria-current="page">{record.title}</li>
      </ol>
      {!study && <p class="fiction-notice" role="note">{fictionalNotice}</p>}
      {kind && <span class="status status--verified">{kind.label}</span>}
      <h1>{record.title}</h1>
      <p class="intro__lead">{record.summary}</p>
      {study && kind && <p class="fineprint">{kind.meaning} Cleared for publication by {study.publicationClearance.clearedBy} on {formatDate(study.publicationClearance.clearedOn)}.</p>}
    </div>
  </section>

  <section class="band band--tight">
    <div class="container">
      <dl class="spec">
        {sections.map(([label, body]) => (
          <div>
            <dt>{label}</dt>
            <dd>{body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {(!study || study.measuredResults.length > 0) && (
    <section class="band band--raised band--tight" aria-labelledby="results-title">
      <div class="container">
        <div class="band-head">
          <h2 id="results-title">Measured results</h2>
          <p>{study ? 'Only what was measured, with how it was measured.' : 'None. A real case reports here only what was measured, with its method. An invented example has nothing to report.'}</p>
        </div>
        {study && (
          <dl class="spec">
            {study.measuredResults.map((result) => (
              <div>
                <dt>{result.indicator}</dt>
                <dd><strong>{result.value}</strong>. {result.method}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    </section>
  )}

  <section class="band band--tight" aria-labelledby="evidence-title">
    <div class="container">
      <div class="band-head">
        <h2 id="evidence-title">{study ? 'Evidence' : 'What you can inspect'}</h2>
        {!study && <p>The scenario is invented; the parts of SAF it names are not.</p>}
      </div>
      <ul class="plain-list">
        {record.evidence.map((link) => <li><a href={link.href} {...externalLinkAttributes}>{link.label}</a></li>)}
      </ul>
      <div class="actions">
        <a class="btn btn-primary" href="/contact/" data-track="business_contact_intent" data-track-id="case-study">Discuss a pilot for your organization</a>
        <a class="btn btn-quiet" href="/case-studies/">{study ? 'All case studies' : 'How pilots are documented'}</a>
      </div>
    </div>
  </section>
</BaseLayout>
