---
/**
 * Contact — where "Discuss your transformation" leads, from every page.
 *
 * One job: let a decision-maker describe a scope in a few lines and reach the
 * team. The form comes first; beside it, what happens next, the address for
 * those who prefer to write, and the public trackers for developers.
 *
 * The transport of the form is a build-time setting; see `contact` in
 * src/data/site.ts and contact-endpoint/README.md. Without a receiver the form
 * prepares an email and says so: the page never shows a confirmation it did
 * not receive, and it promises no delay.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { contactEmail, externalLinkAttributes, offerQualifier } from '../data/site.ts';
import { harness, organization, safLinks } from '../data/saf.ts';

const title = 'Tell us what you want to transform';
const description = 'Describe one team, function or process to Poesis in a few lines. We reply with what a first step could look like. Developers: questions about SAF go to GitHub.';
---
<BaseLayout
  title={title}
  description={description}
  pageType="Contact"
  breadcrumbs={[{ label: 'Contact' }]}
  jsonLd={[{ '@type': 'ContactPage', name: title, url: 'https://poesis.cloud/contact/', description }]}
>
  <section class="intro intro--tight">
    <div class="container">
      <ol class="crumbs" aria-label="Breadcrumb">
        <li><a href="/">Poesis</a></li>
        <li aria-current="page">Contact</li>
      </ol>
      <h1>{title}.</h1>
      <p class="intro__lead">One team, one function or one process is enough to start. Describe it in a few lines, and what you would want to see change.</p>
      <p class="intro__note">{offerQualifier}</p>
    </div>
  </section>

  <section class="band band--tight" aria-labelledby="brief-title">
    <div class="container brief">
      <div>
        <h2 class="sr-only" id="brief-title">Your request</h2>
        <ContactForm source="contact" />
      </div>

      <aside class="brief-aside" aria-label="What happens next, and other ways to reach Poesis">
        <div>
          <h2>What happens next</h2>
          <ol class="next-steps">
            <li>You describe the scope in a few lines.</li>
            <li>We reply with what a first step could look like, or say that Poesis is not the right fit.</li>
            <li>If we go on, scope and terms are agreed in writing before any work starts.</li>
          </ol>
        </div>
        <div>
          <h2>Prefer to write directly?</h2>
          <p>One address reaches the team:</p>
          <p class="address"><a href={`mailto:${contactEmail}`} data-track="business_contact_intent" data-track-id="contact-direct-email">{contactEmail}</a></p>
          <button class="btn btn-ghost btn-sm" type="button" data-copy-address={contactEmail} hidden><Icon name="copy" /> Copy the address</button>
          <p class="copy-status" role="status" aria-live="polite" data-copy-status></p>
          <p>Requests are handled as described in the <a href="/legal/privacy">privacy policy</a>.</p>
        </div>
        <div>
          <h2>Working with SAF on your own?</h2>
          <p>Questions and bug reports about the open-source framework go to GitHub, in public, with no response-time commitment.</p>
          <ul class="plain-list">
            <li><a href={harness.issues} {...externalLinkAttributes} data-track="developer_repo_click" data-track-id="contact-harness-issues">Harness issues</a></li>
            <li><a href={organization.issues} {...externalLinkAttributes} data-track="developer_repo_click" data-track-id="contact-organization-issues">Organization issues</a></li>
            <li><a href={safLinks.docs} {...externalLinkAttributes} data-track="developer_docs_click" data-track-id="contact-docs">SAF documentation</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // The address, one tap away for visitors whose mail is in a browser tab: a mail link opens nothing for them.
  (function () {
    var button = document.querySelector('[data-copy-address]');
    var status = document.querySelector('[data-copy-status]');
    if (!button || !status || !navigator.clipboard) return;
    button.hidden = false;
    button.addEventListener('click', function () {
      navigator.clipboard.writeText(button.getAttribute('data-copy-address')).then(
        function () { status.textContent = 'Address copied.'; },
        function () { status.textContent = 'The address could not be copied. Select it above.'; }
      );
    });
  })();
</script>
