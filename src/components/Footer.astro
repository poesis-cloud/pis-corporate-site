---
import { footerNavigation, legalNavigation } from '../data/site-navigation.ts';

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/" aria-label="Poesis, home">
          <img class="brand-mark" src="/poesis-logo.png" alt="" width="28" height="28" loading="lazy" /> <span>Poesis</span>
        </a>
        <p class="footer-tag">Agentic transformation for organizations, with SAF, the open-source Systemic Agentic Framework, as its method and engine.</p>
      </div>
      {footerNavigation.map((group) => (
        <nav aria-label={group.label}>
          <h2>{group.label}</h2>
          <ul>
            {group.items.map((item) => (
              <li><a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <nav class="footer-legal-links" aria-label="Legal">
      <ul>
        {legalNavigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/legal/cookies" data-cookie-settings>Cookie settings</a></li>
      </ul>
    </nav>
    <div class="footer-legal">
      <span>&copy; {year} Poesis &middot; Founded by <a href="https://www.linkedin.com/in/clement-cazaud" target="_blank" rel="noopener noreferrer">Clément Cazaud</a>.</span>
      <span>&ldquo;Poesis&rdquo;, &ldquo;Generative System Model&rdquo;, &ldquo;Systemic Intelligence Engine&rdquo;, &ldquo;Organizational Intelligence Platform&rdquo;, &ldquo;Systemic Intelligence Sourcing&rdquo;, &ldquo;Systemic Agentic Framework&rdquo;, &ldquo;Systemic Intelligence Model&rdquo; are trademarks of Clément Cazaud. The SAF Agentic Harness and SAF Agentic Organization are released under the Apache License 2.0; this website is proprietary. SAFe&reg; is a registered trademark of Scaled Agile, Inc.; its mention implies no affiliation or endorsement.</span>
    </div>
  </div>
</footer>
