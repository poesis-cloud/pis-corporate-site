---
/**
 * Nav — a handful of destinations and one call to action.
 *
 * Without JavaScript every link is visible and the header simply wraps. With
 * JavaScript (the `js` class set in the document head), below 860px the links
 * fold into a disclosure panel; the call to action stays in the bar at every
 * width. The folded layout is pure CSS, so the page does not shift on load.
 */
import { siteNavigation, navigationCta } from '../data/site-navigation.ts';
import { knowledgeContext } from '../data/knowledge.ts';

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const inKnowledge = knowledgeContext(path).inKnowledge;
const currentOf = (href: string): 'page' | 'true' | undefined => {
  if (path === href) return 'page';
  if (href === '/knowledge/' ? inKnowledge : path.startsWith(href)) return 'true';
  return undefined;
};
/** A click towards the offer is measured as such; the other menu links are not tracked. */
const trackingOf = (href: string) => (href === '/transformation/' ? { 'data-track': 'business_transformation_click', 'data-track-id': 'header' } : {});
---
<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/" aria-label="Poesis, home">
      <img class="brand-mark" src="/poesis-logo.png" alt="" width="28" height="28" />
      <span>Poesis</span>
    </a>
    <nav class="nav-links" id="primary-navigation" aria-label="Primary">
      <ul>
        {siteNavigation.map((item) => (
          <li><a href={item.href} aria-current={currentOf(item.href)} {...trackingOf(item.href)}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="btn btn-primary btn-sm nav-cta" href={navigationCta.href} data-track="business_contact_intent" data-track-id="header">{navigationCta.label}</a>
    <button class="nav-toggle" type="button" aria-controls="primary-navigation" aria-expanded="false">
      <span class="nav-toggle__icon" aria-hidden="true"></span>
      <span class="nav-toggle__label">Menu</span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const nav = document.querySelector<HTMLElement>('#primary-navigation');
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  if (header && nav && toggle) {
    const compact = window.matchMedia('(max-width: 859px)');
    const setOpen = (open: boolean, restoreFocus = false) => {
      const next = compact.matches && open;
      header.classList.toggle('menu-open', next);
      toggle.setAttribute('aria-expanded', String(next));
      if (next) nav.querySelector<HTMLAnchorElement>('a')?.focus();
      else if (restoreFocus) toggle.focus();
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !header.contains(event.target)) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') setOpen(false, true);
    });
    compact.addEventListener('change', () => setOpen(false));
  }
</script>
