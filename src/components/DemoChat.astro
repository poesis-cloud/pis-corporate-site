---
/**
 * DemoChat — two scripted demonstrations in one panel: "Build agentic
 * organizations" and "Run agentic organizations". Each speaks to several
 * profiles, so each holds four short cases asked by four different people
 * (src/data/demo-scenarios.ts).
 *
 * It is a demonstration and says so ("Illustrative demo"): nothing here calls a
 * model, Git or a backend. Every case has the same shape: a request, an answer,
 * then four steps, each with the file, the command or the people it is about.
 * Every word is real text in the page; the script only decides when each part
 * becomes visible, so the panel does not change size while a case plays.
 *
 * With `intro`, the panel opens on a choice: the two sides next to each other, each
 * with its cases, and nothing plays before the visitor has chosen one.
 *
 * Three ways to read it:
 *   scripts on, motion accepted   the cases of a tab play one after the other, once,
 *                                 with pause, next step and replay
 *   reduced motion                the complete picture, tabs, cases and steps still working
 *   no scripts                    the first case of each tab, complete, one under the other
 *
 * What a case prints about SAF is what its repositories document: see the sources
 * listed at the top of src/data/demo-scenarios.ts.
 */
import { demoTabs, type DemoLine } from '../data/demo-scenarios.ts';
import { harness, installCommands, safLinks } from '../data/saf.ts';
import { externalLinkAttributes } from '../data/site.ts';
import { navigationCta } from '../data/site-navigation.ts';

interface Props {
  /** Prefix of the element ids: one per instance on a page. */
  id?: string;
  /** The tab shown first. */
  initial?: 'build' | 'run';
  /** The case shown first in that tab, by its key. The first one when omitted. */
  initialCase?: string;
  /** Names the placement in the measurement events, e.g. `home`. */
  source?: string;
  /** Opens on the choice between the two sides, instead of playing the first tab. */
  intro?: boolean;
}
const { id = 'demo', initial = 'build', initialCase, source = 'home', intro = false } = Astro.props;

const paths: Record<string, string[]> = {
  user: ['M20 21a8 8 0 0 0-16 0', 'M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z'],
  build: ['m12 3 9 5-9 5-9-5z', 'm3 13 9 5 9-5', 'm3 17.5 9 5 9-5'],
  run: ['M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z', 'm10 8.3 5.6 3.7-5.6 3.7z'],
  check: ['m5 12.5 4.5 4.5L19 7.5'],
  cross: ['M6.5 6.5l11 11', 'M17.5 6.5l-11 11'],
  send: ['M12 19V5.5', 'm6 11 6-6 6 6'],
  play: ['M8 5.5v13l10.5-6.5z'],
  pause: ['M8.5 5v14', 'M15.5 5v14'],
  replay: ['M3 12a9 9 0 1 0 3-6.7', 'M3 4v5h5'],
  next: ['M6 5.5v13l9.5-6.5z', 'M18.5 5v14'],
  info: ['M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z', 'M12 11v6', 'M12 7.5v.01'],
  arrow: ['M5 12h14', 'm13 6 6 6-6 6'],
  copy: ['M9 9h11v11H9z', 'M5 15V4h11'],
  external: ['M14 4h6v6', 'M20 4 10 14', 'M18 14v6H4V6h6'],
};
const icon = (name: string) => '<svg class="demo__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">' + paths[name].map((d) => '<path d="' + d + '"/>').join('') + '</svg>';

/** A message that opens on a verdict sets that word apart: "Refused." in the colour of a refusal, "Resolved." in the colour of a success. */
const flag = (text: string) => {
  for (const [word, tone] of [['Refused.', 'no'], ['Resolved.', 'ok']]) if (text.startsWith(word + ' ')) return { word, tone, rest: text.slice(word.length + 1) };
  return { word: '', tone: '', rest: text };
};
/** The kind of a line, for its class. */
const kind = (line: DemoLine) => ('code' in line ? 'code' : 'say' in line ? 'say' : 'roster' in line ? 'roster' : 'refused' in line ? 'refused' : 'resolved' in line ? 'resolved' : 'choice');

const firstStep = 3;
const lastStep = 6;
const scenes = demoTabs.map((tab) => ({
  ...tab,
  label: tab.verb + ' ' + tab.rest,
  current: tab.key === initial ? (tab.cases.find((item) => item.key === initialCase) ?? tab.cases[0]).key : tab.cases[0].key,
}));
---
<div class="demo" data-demo data-initial={initial} data-last={lastStep} data-intro={intro ? '' : undefined}>
 <div class="demo__body">
  {/* The choice, before anything plays: the two sides, and the cases of each. */}
  {intro && (
    <div class="demo__intro" data-demo-intro role="group" aria-labelledby={`${id}-intro-title`}>
      <p class="demo__intro-title" id={`${id}-intro-title`}>
        <span class="demo__avatar demo__avatar--poesis" aria-hidden="true"><img src="/poesis-logo.png" alt="" width="26" height="26" decoding="async" /></span>
        <span class="demo__intro-words"><span>AI agents on their own write what no one checks.</span> <b>Poesis gives them roles, rules and a person who decides.</b></span>
      </p>
      <div class="demo__sides">
        {scenes.map((tab) => (
          <div class={`demo__side demo__side--${tab.key}`}>
            <button class="demo__side-start" type="button" data-start={tab.key}>
              <span class="demo__side-icon" aria-hidden="true"><Fragment set:html={icon(tab.key)} /></span>
              <span class="demo__side-name"><b>{tab.verb}</b> <span>{tab.rest}</span></span>
              <Fragment set:html={icon('arrow')} />
            </button>
            <p class="demo__side-text">{tab.pitch}</p>
            <p class="demo__side-for"><b>For</b> {tab.audience}</p>
            <ol class="demo__side-map">
              {tab.outline.map((entry, index) => <li style={`--i:${index}`}>{entry.code && <code>{entry.code}</code>}<span>{entry.say}</span></li>)}
            </ol>
            <ul class="demo__side-cases" aria-label={`${tab.label}: cases`}>
              {tab.cases.map((item) => (
                <li><button class="demo__side-case" type="button" data-start={tab.key} data-start-case={item.key}><b>{item.label}</b> <span>{item.asker}</span></button></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  )}

 <div class="demo__main">
  <div class="demo__tabs" role="tablist" aria-label="Choose a demonstration">
    {scenes.map((tab) => (
      <button
        class="demo__tab"
        type="button"
        role="tab"
        id={`${id}-tab-${tab.key}`}
        aria-controls={`${id}-panel-${tab.key}`}
        aria-selected={tab.key === initial ? 'true' : 'false'}
        tabindex={tab.key === initial ? 0 : -1}
        data-tab={tab.key}
      >
        <Fragment set:html={icon(tab.key)} /> <span class="demo__tab-name"><b>{tab.verb}</b> <span>{tab.rest}</span></span>
      </button>
    ))}
  </div>

  <div class="demo__panels">
    {scenes.map((tab) => (
      <div
        class:list={['demo__panel', { 'is-active': tab.key === initial }]}
        id={`${id}-panel-${tab.key}`}
        role="tabpanel"
        aria-labelledby={`${id}-tab-${tab.key}`}
        data-panel={tab.key}
      >
        <p class="demo__title">{tab.label}</p>

        {/* The cases of this tab: one person, one request each. */}
        <div class="demo__cases" role="group" aria-label={`${tab.label}: choose a case`}>
          {tab.cases.map((item) => (
            <button class="demo__case" type="button" data-case={item.key} aria-pressed={item.key === tab.current ? 'true' : 'false'} aria-controls={`${id}-${tab.key}-${item.key}`}>
              <span>{item.label}</span>
            </button>
          ))}
        </div>

        <div class="demo__stage">
          {tab.cases.map((item) => (
            <div
              class:list={['demo__scene', { 'is-current': item.key === tab.current }]}
              id={`${id}-${tab.key}-${item.key}`}
              data-scene={item.key}
              data-delays="600,1900,3000,3500,3500,3500"
            >
              {/* The conversation: what was said scrolls up as in any chat, and the request is typed in the message field. */}
              <div class="demo__talk">
                <div class="demo__log" role="group" aria-label="Conversation" tabindex="0" data-log>
                  <div class="demo__row demo__row--you" data-step="1" data-say="The request">
                    <div class="demo__said demo__said--you">
                      <p class="demo__who">{item.asker}</p>
                      <p class="demo__bubble"><span class="sr-only">{item.asker} asks: </span>{item.ask}</p>
                    </div>
                    <span class="demo__avatar" aria-hidden="true"><Fragment set:html={icon('user')} /></span>
                  </div>
                  <div class="demo__row demo__row--poesis" data-step="2" data-say={`${item.responder} answers`}>
                    <span class="demo__avatar demo__avatar--poesis" aria-hidden="true"><img src="/poesis-logo.png" alt="" width="26" height="26" loading="lazy" decoding="async" /></span>
                    <div class="demo__said">
                      <p class:list={['demo__who', { 'demo__who--agent': item.responderRole }]}>{item.responder}{item.responderRole && <span> · {item.responderRole}</span>}</p>
                      <p class="demo__bubble demo__bubble--poesis"><span class="demo__dots" aria-hidden="true"><i></i><i></i><i></i></span><span data-words>{item.reply}</span></p>
                    </div>
                  </div>
                  {item.steps.map((step, index) => {
                    const said = flag(step.tell);
                    return (
                      <div class="demo__row demo__row--poesis demo__row--next" data-step={firstStep + index}>
                        <p class:list={['demo__bubble', 'demo__bubble--poesis', said.tone && `demo__bubble--${said.tone}`]}><span class="demo__dots" aria-hidden="true"><i></i><i></i><i></i></span>{said.word && <b class="demo__flag">{said.word} </b>}<span data-words>{said.rest}</span></p>
                      </div>
                    );
                  })}
                </div>
                <div class="demo__composer" aria-hidden="true">
                  <span class="demo__field"><span class="demo__typed" data-type={item.ask}></span><span class="demo__placeholder">{tab.placeholder}</span></span>
                  <span class="demo__send"><Fragment set:html={icon('send')} /></span>
                </div>
              </div>

              <div class="demo__build" data-step={firstStep}>
                <ol class="demo__path">
                  {item.steps.map((step, index) => (
                    <li>
                      <button class:list={['demo__chip', { 'demo__chip--refused': step.refused }]} type="button" data-chip={firstStep + index} aria-controls={`${id}-${tab.key}-${item.key}-view-${firstStep + index}`}>
                        <span class="demo__chip-mark" aria-hidden="true"><i>{index + 1}</i><Fragment set:html={icon(step.refused ? 'cross' : 'check')} /></span>
                        <span>{step.title}</span>
                      </button>
                    </li>
                  ))}
                </ol>
                <div class="demo__views">
                  {item.steps.map((step, index) => (
                    <div class="demo__view" id={`${id}-${tab.key}-${item.key}-view-${firstStep + index}`} data-view={firstStep + index}>
                      <p class="demo__view-title"><span aria-hidden="true"><i></i><i></i><i></i></span><span class="demo__view-name">{step.window}</span><span class="sr-only">: {step.title}</span></p>
                      <ul class="demo__lines">
                        {step.lines.map((line, row) => (
                          <li class={`demo__line demo__line--${kind(line)}`} style={`--i:${row}`}>
                            {'code' in line && <>
                              {line.prompt && <span class="demo__prompt" aria-hidden="true">$</span>}
                              <code>{line.code}</code>
                              {line.tag && <span class="demo__tag">{line.tag}</span>}
                            </>}
                            {'refused' in line && <><span class="demo__no"><Fragment set:html={icon('cross')} />Refused</span><code>{line.refused}</code></>}
                            {'resolved' in line && <><span class="demo__yes"><Fragment set:html={icon('check')} />Resolved</span><span>{line.resolved}</span></>}
                            {'say' in line && line.say}
                            {'roster' in line && line.roster.map((agent, seat) => <span class="demo__seat" style={`--j:${seat}`}><Fragment set:html={icon('check')} /><code>{agent}</code></span>)}
                            {'choice' in line && line.choice.map((answer, place) => <span class:list={['demo__answer', { 'is-chosen': place === 0 }]}>{place === 0 && <Fragment set:html={icon('check')} />}{answer}{place === 0 && <span class="sr-only"> (the answer played here)</span>}</span>)}
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>

        {tab.key === 'run'
          ? (
            <div class="demo__actions">
              <a class="demo__cta" href={navigationCta.href} data-track="business_contact_intent" data-track-id={`${source}-demo-run`}>{navigationCta.label} <Fragment set:html={icon('arrow')} /></a>
              <span class="demo__links">
                <a href={safLinks.usageModel} {...externalLinkAttributes} data-track="developer_docs_click" data-track-id={`${source}-demo-usage-model`}>Read the usage model</a>
              </span>
            </div>
          )
          : (
            <div class="demo__actions">
              <a class="demo__cta" href={safLinks.repositories} {...externalLinkAttributes} data-track="developer_repo_click" data-track-id={`${source}-demo-build`}>Explore SAF on GitHub <Fragment set:html={icon('external')} /></a>
              <button class="demo__copy" type="button" data-demo-copy={installCommands.join('\n')} aria-label="Copy the install commands"><Fragment set:html={icon('copy')} /> <span data-demo-copy-label>Copy install</span></button>
              <span class="demo__links">
                <a href={safLinks.docs} {...externalLinkAttributes} data-track="developer_docs_click" data-track-id={`${source}-demo-docs`}>Read the docs</a>
                <a href={harness.contributing} {...externalLinkAttributes} data-track="developer_repo_click" data-track-id={`${source}-demo-contributing`}>Contribute</a>
              </span>
            </div>
          )}
      </div>
    ))}
  </div>

 </div>
 </div>

  <div class="demo__foot">
    <p class="demo__note"><Fragment set:html={icon('info')} /> Illustrative demo. Scripted, not a live run of SAF.</p>
    <div class="demo__controls" role="group" aria-label="Demonstration controls">
      <button class="demo__control" type="button" data-demo-toggle aria-label="Pause the demonstration">
        <span class="demo__control-pause"><Fragment set:html={icon('pause')} /></span>
        <span class="demo__control-play"><Fragment set:html={icon('play')} /></span>
      </button>
      <button class="demo__control" type="button" data-demo-next aria-label="Show the next step"><Fragment set:html={icon('next')} /></button>
      <button class="demo__control" type="button" data-demo-replay aria-label="Replay the demonstration"><Fragment set:html={icon('replay')} /></button>
      <span class="demo__dots-track" aria-hidden="true">{Array.from({ length: lastStep }, () => <i></i>)}</span>
    </div>
    <p class="sr-only" role="status" aria-live="polite" data-demo-status></p>
  </div>
</div>

<script>
  import '../scripts/demo-chat.ts';
</script>

<style is:global>
  /* ---- shell ------------------------------------------------------------------ */
  .demo {
    --demo-line: rgba(148, 197, 222, .16);
    --demo-line-strong: rgba(94, 234, 212, .34);
    --demo-ok: #4ade80;
    --demo-no: #f87171;
    --demo-ease: cubic-bezier(.22, .61, .36, 1);
    container-type: inline-size;
    position: relative;
    display: grid;
    gap: clamp(.85rem, 2.6cqi, 1.15rem);
    width: 100%;
    padding: clamp(.85rem, 3.4cqi, 1.5rem);
    border: 1px solid var(--demo-line-strong);
    border-radius: clamp(18px, 4.5cqi, 26px);
    background:
      radial-gradient(120% 70% at 100% 0%, rgba(56, 189, 248, .1), transparent 60%),
      linear-gradient(180deg, rgba(17, 27, 46, .94), rgba(8, 13, 25, .96));
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .03) inset, 0 34px 80px -34px rgba(0, 0, 0, .8), 0 0 70px -28px rgba(45, 212, 191, .38);
    font-family: var(--font-sans);
    font-size: .95rem;
    line-height: 1.4;
    color: var(--ink);
    text-align: left;
  }

  .demo p,
  .demo ol,
  .demo ul {
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: none;
  }

  .demo__icon {
    flex: none;
    width: 1.15em;
    height: 1.15em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---- body: the choice first when there is one, then the tabs and their cases --- */
  .demo__body {
    display: grid;
    min-width: 0;
  }

  .demo__main {
    display: grid;
    gap: clamp(.85rem, 2.6cqi, 1.15rem);
    min-width: 0;
  }

  /* Build takes the teal end of the brand, Run its blue end. */
  .demo__side--build,
  .demo__tab[data-tab="build"] {
    --side: #5eead4;
    --side-soft: rgba(45, 212, 191, .14);
    --side-line: rgba(94, 234, 212, .5);
  }

  .demo__side--run,
  .demo__tab[data-tab="run"] {
    --side: #7dd3fc;
    --side-soft: rgba(56, 189, 248, .14);
    --side-line: rgba(125, 211, 252, .5);
  }

  .demo__intro {
    display: none;
    align-content: start;
    gap: clamp(.85rem, 2.6cqi, 1.15rem);
    min-width: 0;
  }

  .js .demo[data-intro]:not(.is-chosen) .demo__intro {
    display: grid;
  }

  /* While a visitor chooses, the cases wait out of sight: nothing of them shows or takes focus. */
  .js .demo[data-intro]:not(.is-chosen) .demo__main {
    display: none;
  }

  .js .demo[data-intro]:not(.is-chosen) .demo__controls {
    visibility: hidden !important;
  }

  .demo .demo__intro-title {
    display: flex;
    align-items: center;
    gap: .7rem;
    font-size: clamp(1.02rem, 4.2cqi, 1.2rem);
    font-weight: 700;
    line-height: 1.2;
    color: #fff;
  }

  /* What Poesis is about, in two short lines: the problem, then the answer. */
  .demo__intro-words {
    display: grid;
    gap: .15rem;
    min-width: 0;
  }

  .demo__intro-words > span {
    font-size: .86rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--ink-soft);
  }

  .demo__intro-words > b {
    font-weight: 700;
    line-height: 1.25;
    text-wrap: balance;
  }

  .demo .demo__intro-title {
    align-items: flex-start;
  }

  /* Who a side speaks to. */
  .demo .demo__side-for {
    padding-inline: .2rem;
    font-size: .82rem;
    line-height: 1.4;
    color: var(--ink);
  }

  .demo__side-for b {
    margin-right: .25rem;
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--side);
  }

  .demo__sides {
    display: grid;
    gap: .75rem;
    min-width: 0;
  }

  .demo__side {
    display: flex;
    flex-direction: column;
    gap: .6rem;
    min-width: 0;
    padding: .7rem;
    border: 1px solid var(--demo-line);
    border-radius: 18px;
    background: linear-gradient(180deg, var(--side-soft), rgba(15, 23, 42, .35) 55%);
  }

  .demo__side-start {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: .7rem;
    width: 100%;
    min-height: 3.5rem;
    padding: .5rem .7rem .5rem .5rem;
    border: 1px solid var(--side-line);
    border-radius: 13px;
    background: rgba(4, 9, 18, .5);
    font: inherit;
    line-height: 1.15;
    color: #fff;
    text-align: left;
    cursor: pointer;
    transition: background-color .2s, border-color .2s, box-shadow .2s;
  }

  .demo__side-start:hover {
    border-color: var(--side);
    background: var(--side-soft);
    box-shadow: 0 0 26px -10px var(--side);
  }

  .demo__side-start > .demo__icon {
    color: var(--side);
    transition: transform .2s var(--demo-ease);
  }

  .demo__side-start:hover > .demo__icon {
    transform: translateX(3px);
  }

  .demo__side-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 11px;
    background: var(--side);
    color: #04121c;
    font-size: 1.2rem;
  }

  .demo__side-name {
    display: grid;
    gap: .1rem;
    min-width: 0;
  }

  .demo__side-name b {
    font-size: 1.22rem;
    font-weight: 750;
    letter-spacing: -.01em;
  }

  .demo__side-name > span {
    font-size: .82rem;
    font-weight: 550;
    color: var(--ink-soft);
  }

  .demo .demo__side-text {
    padding-inline: .2rem;
    font-size: .88rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  /* The side at a glance: a short rail of what is declared, or of what happens. Shown where there is room. */
  .demo .demo__side-map {
    display: none;
    gap: .5rem;
    margin-block: auto;
    padding-inline: .35rem;
  }

  .demo__side-map li {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 .55rem;
    padding-left: 1.35rem;
    font-size: .84rem;
    line-height: 1.35;
    color: var(--ink-soft);
  }

  .demo__side-map li::before {
    content: "";
    position: absolute;
    top: .42em;
    left: 0;
    width: .5rem;
    height: .5rem;
    border: 1.5px solid var(--side);
    border-radius: 50%;
  }

  .demo__side-map li + li::after {
    content: "";
    position: absolute;
    bottom: calc(100% - .32em);
    left: calc(.25rem + .5px);
    width: 1px;
    height: calc(.5rem + .55em);
    background: var(--side-line);
  }

  .demo__side-map li:last-child::before {
    background: var(--side);
    box-shadow: 0 0 10px var(--side);
  }

  .demo__side-map li:last-child span {
    font-weight: 650;
    color: #fff;
  }

  .demo__side-map code {
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--font-mono);
    font-size: .8rem;
    color: #fff;
  }

  /* Build is a list of what is declared, with no last step to light up. */
  .demo__side--build .demo__side-map li:last-child span {
    font-weight: inherit;
    color: inherit;
  }

  .demo__side--build .demo__side-map li:last-child::before {
    background: none;
    box-shadow: none;
  }

  .demo .demo__side-cases {
    display: grid;
    gap: .3rem;
    margin-top: auto;
  }

  .demo__side-case {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    align-content: center;
    gap: 0 .6rem;
    width: 100%;
    min-height: 44px;
    padding: .3rem .7rem;
    border: 1px solid var(--demo-line);
    border-radius: 11px;
    background: rgba(15, 23, 42, .5);
    font: inherit;
    line-height: 1.2;
    text-align: left;
    cursor: pointer;
    transition: border-color .2s, background-color .2s;
  }

  .demo__side-case b {
    font-size: .9rem;
    font-weight: 650;
    color: #fff;
  }

  .demo__side-case span {
    font-size: .78rem;
    color: var(--muted);
  }

  .demo__side-case:hover {
    border-color: var(--side-line);
    background: var(--side-soft);
  }

  .demo__side-case:hover span {
    color: var(--ink-soft);
  }

  /* ---- tabs -------------------------------------------------------------------- */
  .demo__tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .3rem;
    padding: .3rem;
    border: 1px solid var(--demo-line);
    border-radius: 999px;
    background: rgba(4, 9, 18, .55);
  }

  .demo__tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    min-height: 44px;
    padding: .3rem .6rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: none;
    font: inherit;
    font-weight: 600;
    font-size: clamp(.82rem, 3.6cqi, .98rem);
    line-height: 1.15;
    color: var(--ink-soft);
    cursor: pointer;
    transition: color .2s, background-color .2s, border-color .2s, box-shadow .2s;
  }

  .demo__tab:hover {
    color: #fff;
  }

  /* "Build" then "agentic organizations": on one line when there is room, one under the other when not. */
  .demo__tab-name {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 .32em;
  }

  .demo__tab-name b {
    font-weight: 750;
  }

  .demo__tab-name > span {
    font-weight: 550;
  }

  .demo__tab[aria-selected="true"] {
    border-color: var(--side-line);
    background: linear-gradient(180deg, var(--side-soft), rgba(56, 189, 248, .08)), rgba(45, 212, 191, .1);
    box-shadow: 0 0 22px -8px var(--side), 0 1px 0 rgba(255, 255, 255, .12) inset;
    color: #fff;
  }

  .demo__tab[aria-selected="true"] > .demo__icon {
    color: var(--side);
  }

  .demo :focus-visible {
    outline: 2px solid #a5f3fc;
    outline-offset: 2px;
  }

  /* ---- panels: with scripts, one at a time ------------------------------------- */
  .demo__panels {
    display: grid;
    gap: 1.5rem;
  }

  .demo__panel {
    display: flex;
    flex-direction: column;
    gap: clamp(.65rem, 2.4cqi, .9rem);
    min-width: 0;
    transition: opacity .18s;
  }

  .demo__panel.is-resetting {
    opacity: 0;
  }

  .demo .demo__title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--flow-ink);
  }

  /* With scripts the tab names the scenario. */
  .js .demo .demo__title {
    display: none;
  }

  .js .demo__panel:not(.is-active) {
    display: none;
  }

  html:not(.js) .demo__tabs,
  html:not(.js) .demo__cases {
    display: none;
  }

  /* ---- the cases of a tab: one person, one request each ------------------------- */
  .demo__cases {
    display: flex;
    flex-wrap: wrap;
    gap: .35rem;
  }

  .demo__case {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 auto;
    min-height: 44px;
    padding: .3rem .7rem;
    border: 1px solid var(--demo-line);
    border-radius: 12px;
    background: rgba(15, 23, 42, .5);
    font: inherit;
    font-size: .82rem;
    font-weight: 600;
    line-height: 1.15;
    color: var(--ink-soft);
    cursor: pointer;
    overflow: hidden;
    transition: color .2s, border-color .2s, background-color .2s;
  }

  .demo__case > span {
    position: relative;
  }

  .demo__case:hover {
    border-color: var(--demo-line-strong);
    color: #fff;
  }

  .demo__case[aria-pressed="true"] {
    border-color: rgba(94, 234, 212, .6);
    background: rgba(45, 212, 191, .12);
    color: #fff;
  }

  /* The case that plays next fills up while the one on show holds its last picture. */
  .demo__case::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(45, 212, 191, .2);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* With scripts one case shows at a time; without, the first of each tab. */
  .demo__stage {
    display: grid;
    min-width: 0;
  }

  .demo__scene {
    display: flex;
    flex-direction: column;
    gap: clamp(.65rem, 2.4cqi, .9rem);
    min-width: 0;
    transition: opacity .18s;
  }

  .demo__scene.is-resetting {
    opacity: 0;
  }

  .js .demo__scene:not(.is-current),
  html:not(.js) .demo__scene:not(:first-child) {
    display: none;
  }

  /* ---- the conversation -------------------------------------------------------- */
  .demo__talk {
    display: grid;
    gap: .55rem;
    min-width: 0;
  }

  .demo__log {
    display: flex;
    flex-direction: column;
    gap: clamp(.5rem, 2cqi, .7rem);
    min-width: 0;
  }

  /* Played, the conversation keeps one height: a message that arrives pushes the earlier ones up, as in any chat.
     The height is set before the script answers, so that nothing moves on the page when it does. */
  @media (prefers-reduced-motion: no-preference) {
    .js .demo__log {
      height: 9.5rem;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: none;
      -webkit-mask-image: linear-gradient(180deg, transparent, #000 .7rem);
      mask-image: linear-gradient(180deg, transparent, #000 .7rem);
    }

    .js .demo__log::-webkit-scrollbar {
      display: none;
    }
  }

  .demo__log > :first-child {
    margin-top: auto;
  }

  /* A message that was not said yet takes no room in the conversation. */
  .js .demo.is-ready .demo__log > [data-step]:not(.is-on) {
    display: none;
  }

  /* The messages that follow the first answer come from the same voice: no face, same margin. */
  .demo__row--next {
    padding-left: calc(2.25rem + .6rem);
  }

  .demo .demo__bubble--no {
    border-color: rgba(248, 113, 113, .5);
    background: rgba(248, 113, 113, .09);
  }

  .demo .demo__bubble--ok {
    border-color: rgba(74, 222, 128, .5);
    background: rgba(34, 197, 94, .1);
  }

  .demo__flag {
    font-weight: 750;
  }

  .demo__bubble--no .demo__flag {
    color: var(--demo-no);
  }

  .demo__bubble--ok .demo__flag {
    color: var(--demo-ok);
  }

  /* The message field: the request is typed here, then sent. It is a picture of a field, not one. */
  .demo__composer {
    display: flex;
    align-items: center;
    gap: .5rem;
    min-height: 44px;
    padding: .3rem .35rem .3rem .9rem;
    border: 1px solid var(--demo-line);
    border-radius: 14px;
    background: rgba(4, 9, 18, .6);
  }

  html:not(.js) .demo__composer {
    display: none;
  }

  .demo__field {
    display: grid;
    flex: 1;
    align-items: center;
    min-width: 0;
    font-size: .92rem;
    line-height: 1.35;
  }

  .demo__field > * {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .demo__placeholder {
    color: var(--muted);
  }

  .demo__typed {
    visibility: hidden;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--ink);
  }

  .demo__key {
    position: relative;
  }

  .demo__send {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 10px;
    background: linear-gradient(140deg, #5eead4, #38bdf8);
    color: #04121c;
    font-size: 1rem;
  }

  .demo__send .demo__icon {
    stroke-width: 2.4;
  }

  .demo__row {
    display: flex;
    align-items: flex-start;
    gap: .6rem;
    min-width: 0;
  }

  .demo__row--you {
    justify-content: flex-end;
    padding-left: 12%;
  }

  .demo__row--poesis {
    padding-right: 8%;
  }

  .demo__avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--demo-line);
    border-radius: 50%;
    background: rgba(148, 163, 184, .16);
    color: var(--ink-soft);
  }

  /* The Poesis mark, as the face of whoever answers: the helix of the logo on the colours of the brand. */
  .demo__avatar--poesis {
    position: relative;
    border: 0;
    border-radius: 12px;
    background: linear-gradient(140deg, #5eead4, #38bdf8);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .22) inset, 0 6px 18px -6px rgba(45, 212, 191, .75);
  }

  .demo__avatar--poesis::after {
    content: "";
    position: absolute;
    inset: -1px;
    border: 2px solid #5eead4;
    border-radius: 13px;
    opacity: 0;
    pointer-events: none;
  }

  .demo__avatar img {
    display: block;
    width: 26px;
    height: 26px;
  }

  .demo__said {
    display: grid;
    gap: .25rem;
    min-width: 0;
  }

  .demo__said--you {
    justify-items: end;
  }

  .demo .demo__who {
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--flow-ink);
  }

  .demo .demo__said--you .demo__who {
    color: var(--muted);
  }

  /* An agent of the organization answers under its own name, as written in its repository. */
  .demo .demo__who--agent {
    font-family: var(--font-mono);
    font-size: .78rem;
    letter-spacing: 0;
    text-transform: none;
    overflow-wrap: anywhere;
  }

  .demo__who--agent > span {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--muted);
  }

  .demo .demo__bubble {
    position: relative;
    min-width: 0;
    padding: .6rem .85rem;
    border: 1px solid var(--demo-line);
    border-radius: 14px 14px 4px 14px;
    background: rgba(148, 163, 184, .12);
    color: var(--ink);
    overflow-wrap: break-word;
  }

  .demo .demo__bubble--poesis {
    border-color: rgba(94, 234, 212, .26);
    border-radius: 4px 14px 14px 14px;
    background: rgba(45, 212, 191, .07);
  }

  .demo__dots {
    position: absolute;
    top: .95rem;
    left: .9rem;
    display: none;
    gap: .28rem;
  }

  .demo__dots i {
    width: .4rem;
    height: .4rem;
    border-radius: 50%;
    background: var(--flow-ink);
  }

  /* ---- the steps of a case, and the file, command or people each one is about ---- */
  .demo__build {
    display: grid;
    gap: .6rem;
    min-width: 0;
  }

  .demo__path {
    display: grid;
    gap: .3rem;
  }

  .demo__chip {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: .6rem;
    width: 100%;
    min-height: 44px;
    padding: .3rem .65rem;
    border: 1px solid var(--demo-line);
    border-radius: 12px;
    background: rgba(15, 23, 42, .5);
    font: inherit;
    font-size: .9rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink-soft);
    text-align: left;
    cursor: pointer;
    transition: color .25s, border-color .25s, background-color .25s;
  }

  .demo__chip:hover {
    color: #fff;
    border-color: var(--demo-line-strong);
  }

  .demo__chip-mark {
    display: grid;
    place-items: center;
    width: 1.45rem;
    height: 1.45rem;
    border: 1px solid var(--demo-line-strong);
    border-radius: 50%;
    font-size: .78rem;
    color: var(--flow-ink);
    transition: background-color .25s, border-color .25s, color .25s;
  }

  .demo__chip-mark > * {
    grid-area: 1 / 1;
    transition: opacity .25s, transform .25s var(--demo-ease);
  }

  .demo__chip-mark i {
    font-style: normal;
    font-weight: 700;
  }

  .demo__chip-mark .demo__icon {
    opacity: 0;
    transform: scale(.5);
    stroke-width: 3;
  }

  .demo__chip.is-done {
    color: var(--ink);
  }

  .demo__chip.is-done .demo__chip-mark {
    border-color: var(--demo-ok);
    background: var(--demo-ok);
    color: #052e16;
  }

  .demo__chip.is-done .demo__chip-mark i {
    opacity: 0;
  }

  .demo__chip.is-done .demo__chip-mark .demo__icon {
    opacity: 1;
    transform: none;
  }

  /* A step that ends on a refusal says so: a cross, in the colour of a refusal. */
  .demo__chip--refused.is-done .demo__chip-mark {
    border-color: var(--demo-no);
    background: var(--demo-no);
    color: #2a0a0a;
  }

  .demo__chip[aria-current="step"] {
    border-color: rgba(94, 234, 212, .6);
    background: rgba(45, 212, 191, .1);
    color: #fff;
  }

  .demo__views {
    display: grid;
    gap: .5rem;
    min-width: 0;
  }

  .demo__view {
    display: grid;
    align-content: start;
    gap: .5rem;
    min-width: 0;
    padding: .6rem .75rem .7rem;
    border: 1px solid var(--demo-line);
    border-radius: 12px;
    background: rgba(3, 7, 15, .72);
  }

  .demo .demo__view-title {
    display: flex;
    align-items: center;
    gap: .55rem;
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .02em;
    color: var(--muted);
  }

  /* The name of a window is often a path: it breaks where it must. */
  .demo__view-name {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .demo__view-title > span[aria-hidden] {
    display: inline-flex;
    gap: .25rem;
  }

  .demo__view-title i {
    width: .45rem;
    height: .45rem;
    border-radius: 50%;
    background: rgba(148, 163, 184, .35);
  }

  .demo__lines {
    display: grid;
    gap: .3rem;
  }

  .demo__line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .1rem .5rem;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: .76rem;
    line-height: 1.45;
    color: #d6e4f5;
  }

  .demo__line code {
    min-width: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .demo__prompt {
    color: var(--flow-ink);
    user-select: none;
  }

  /* A sentence about what the window shows. */
  .demo__line--say {
    font-family: var(--font-sans);
    font-size: .8rem;
    line-height: 1.4;
    color: #a9b8cc;
  }

  /* The question of a gate is the one line a person has to answer. */
  .demo__view[data-view="6"] .demo__line--say:first-child {
    font-size: .88rem;
    font-weight: 600;
    color: #fff;
  }

  /* The harness says no: the word, then the rule that refuses. */
  .demo__line--refused {
    align-items: center;
    gap: .35rem .6rem;
    padding: .45rem .6rem;
    border: 1px solid rgba(248, 113, 113, .45);
    border-radius: 10px;
    background: rgba(248, 113, 113, .09);
    color: #fecaca;
  }

  .demo__no {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    font-family: var(--font-sans);
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--demo-no);
  }

  .demo__no .demo__icon {
    width: 1em;
    height: 1em;
    stroke-width: 3;
  }

  /* What the refusal led to, once remedied. */
  .demo__line--resolved {
    align-items: center;
    gap: .2rem .6rem;
    padding: .45rem .6rem;
    border: 1px solid rgba(74, 222, 128, .45);
    border-radius: 10px;
    background: rgba(34, 197, 94, .1);
    font-family: var(--font-sans);
    font-size: .8rem;
    color: #dcfce7;
  }

  .demo__yes {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--demo-ok);
  }

  .demo__yes .demo__icon {
    width: 1em;
    height: 1em;
    stroke-width: 3;
  }

  /* The experts of a challenge panel, each with its packet written. */
  .demo__line--roster {
    gap: .3rem;
  }

  .demo__seat {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    padding: .2rem .5rem .2rem .4rem;
    border: 1px solid var(--demo-line);
    border-radius: 999px;
    background: rgba(148, 163, 184, .08);
    font-size: .75rem;
    line-height: 1.3;
  }

  .demo__seat .demo__icon {
    width: .85em;
    height: .85em;
    stroke-width: 2.8;
    color: var(--demo-ok);
  }

  /* The answers of a gate: the one this case plays, and the others a person can give. */
  .demo__line--choice {
    gap: .35rem;
    padding-block: .1rem;
    font-family: var(--font-sans);
  }

  .demo__answer {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    padding: .25rem .65rem;
    border: 1px solid var(--demo-line);
    border-radius: 9px;
    font-size: .8rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--muted);
  }

  .demo__answer.is-chosen {
    position: relative;
    color: #fff;
  }

  /* Its green ground is a layer of its own, so that it can arrive by opacity alone. */
  .demo__answer.is-chosen::before {
    content: "";
    position: absolute;
    inset: -1px;
    border: 1px solid rgba(74, 222, 128, .65);
    border-radius: inherit;
    background: rgba(34, 197, 94, .16);
    pointer-events: none;
  }

  .demo__answer .demo__icon {
    width: .9em;
    height: .9em;
    stroke-width: 3;
    color: var(--demo-ok);
  }

  .demo__tag {
    font-family: var(--font-sans);
    font-size: .75rem;
    color: var(--flow-ink);
  }

  /* With scripts the four views share one place, and one shows at a time. */
  .js .demo__views > .demo__view {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity .28s, visibility 0s .28s;
  }

  /* A case that leaves takes its window with it at once: nothing of it fades over the next one. */
  .js .demo__scene:not(.is-current) .demo__view,
  .js .demo__panel:not(.is-active) .demo__view {
    transition: none;
  }

  .js .demo__panel.is-active .demo__scene.is-current .demo__views > .demo__view.is-current {
    opacity: 1;
    visibility: visible;
    transition: opacity .28s;
  }

  /* ---- actions of each scenario ------------------------------------------------ */
  .demo__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .4rem .6rem;
  }

  .demo__cta,
  .demo__copy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    min-height: 44px;
    padding: .35rem .95rem;
    border: 1px solid rgba(94, 234, 212, .55);
    border-radius: 12px;
    background: rgba(45, 212, 191, .1);
    font: inherit;
    font-size: .92rem;
    font-weight: 650;
    line-height: 1.2;
    color: #fff;
    text-decoration: none;
    cursor: pointer;
    transition: background-color .2s, border-color .2s, box-shadow .2s;
  }

  .demo__cta:hover,
  .demo__copy:hover {
    border-color: var(--accent-ink);
    background: rgba(45, 212, 191, .2);
    box-shadow: 0 0 24px -8px rgba(45, 212, 191, .7);
    color: #fff;
  }

  .demo__copy {
    border-color: var(--demo-line);
    background: rgba(15, 23, 42, .5);
    font-weight: 600;
    color: var(--ink-soft);
  }

  .demo__links {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0 .35rem;
  }

  .demo__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: .45rem;
    font-size: .9rem;
    font-weight: 600;
    color: var(--flow-ink);
    text-decoration: underline;
    text-decoration-color: rgba(94, 234, 212, .4);
    text-underline-offset: 3px;
  }

  .demo__links a:hover {
    color: #fff;
  }

  /* ---- foot: what this is, and the controls ------------------------------------ */
  .demo__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: .35rem 1rem;
    padding-top: clamp(.6rem, 2.2cqi, .85rem);
    border-top: 1px solid var(--demo-line);
  }

  .demo .demo__note {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    min-height: 2rem;
    font-size: .8rem;
    color: var(--muted);
  }

  .demo__controls {
    display: flex;
    align-items: center;
    gap: .35rem;
    margin-left: auto;
  }

  /* The controls and the copy button need the script. Where it will show them, their place is
     kept from the first paint, so that nothing moves when they appear. */
  .demo .demo__controls,
  .demo .demo__copy {
    display: none;
  }

  .js .demo .demo__copy {
    display: inline-flex;
    visibility: hidden;
  }

  /* Only in the scenario on show: a visible child would show through a hidden panel. */
  .js .demo .demo__panel.is-active .demo__copy.is-on {
    visibility: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .js .demo .demo__controls {
      display: flex;
      visibility: hidden;
    }

    .js .demo.is-live .demo__controls {
      visibility: visible;
    }
  }

  .demo__control {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--demo-line-strong);
    border-radius: 50%;
    background: rgba(15, 23, 42, .55);
    color: var(--ink);
    font-size: 1rem;
    cursor: pointer;
    transition: color .2s, border-color .2s, background-color .2s, opacity .2s;
  }

  .demo__control:hover {
    border-color: var(--accent-ink);
    color: #fff;
  }

  .demo__control[aria-disabled="true"] {
    opacity: .38;
    cursor: default;
  }

  .demo__control > span {
    display: grid;
    grid-area: 1 / 1;
  }

  .demo .demo__control-pause,
  .demo.is-playing .demo__control-play {
    display: none;
  }

  .demo.is-playing .demo__control-pause {
    display: grid;
  }

  .demo__control-play .demo__icon {
    fill: currentColor;
    stroke-width: 1.2;
  }

  .demo__dots-track {
    display: inline-flex;
    gap: .32rem;
