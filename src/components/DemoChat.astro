    background: rgba(148, 163, 184, .32);
    transition: background-color .3s, transform .3s;
  }

  .demo__dots-track i.is-done {
    background: rgba(94, 234, 212, .6);
  }

  .demo__dots-track i.is-now {
    background: #5eead4;
    transform: scale(1.3);
  }

  /* A narrow panel: the bubbles take the width they can, and the name of a tab stands on two lines. */
  @container (max-width: 27.99rem) {
    .demo__tabs {
      border-radius: 18px;
    }

    .demo__tab {
      border-radius: 14px;
      padding-block: .4rem;
    }

    .demo__tab > .demo__icon {
      display: none;
    }

    .demo__tab-name {
      display: grid;
      justify-items: center;
      gap: .05rem;
    }

    .demo__tab-name b {
      font-size: 1.02rem;
    }

    .demo__tab-name > span {
      font-size: .76rem;
    }
  }

  @container (max-width: 23.99rem) {
    .demo__row--you {
      padding-left: 5%;
    }

    .demo__row--poesis {
      padding-right: 0;
    }

    .demo__avatar {
      width: 2rem;
      height: 2rem;
    }

    .demo__avatar img {
      width: 22px;
      height: 22px;
    }

    .demo__row--next {
      padding-left: calc(2rem + .6rem);
    }

    @media (prefers-reduced-motion: no-preference) {
      .js .demo__log {
        height: 13.5rem;
      }
    }

    .demo__case {
      padding-inline: .5rem;
    }
  }

  /* The narrowest panels: four cases on two rows of two, never three and one. */
  @container (max-width: 18.99rem) {
    .demo__cases {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }

  /* The cases of a tab keep one footprint, so that playing them in turn moves nothing on the page. */
  .js .demo__stage > .demo__scene {
    grid-area: 1 / 1;
  }

  .js .demo__stage > .demo__scene:not(.is-current) {
    display: flex;
    visibility: hidden;
  }

  /* ---- room to spare: the steps beside their window ----------------------------- */
  @container (min-width: 27rem) {
    .demo__build {
      grid-template-columns: minmax(0, .82fr) minmax(0, 1fr);
      align-items: stretch;
      gap: .75rem;
    }

    .demo__view {
      height: 100%;
    }

    /* With a mouse the steps can be a little lower; a finger keeps its 44 px. */
    @media (hover: hover) and (pointer: fine) {
      .demo__chip {
        min-height: 40px;
        padding-block: .2rem;
      }
    }

    /* The choice and the cases share one place, so that choosing moves nothing on the page. */
    .demo__sides {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      height: 100%;
    }

    .demo__intro {
      grid-template-rows: auto minmax(0, 1fr);
    }

    .demo .demo__side-map {
      display: grid;
    }

    .demo .demo__side-cases {
      margin-top: 0;
    }

    .js .demo__body > * {
      grid-area: 1 / 1;
    }

    .js .demo[data-intro]:not(.is-chosen) .demo__main {
      display: grid;
    }

    /* Once a side is chosen the choice keeps its place, out of sight, so that the panel keeps its height. */
    .js .demo[data-intro].is-chosen .demo__intro {
      display: grid;
      visibility: hidden;
    }

    .js .demo[data-intro]:not(.is-chosen) .demo__main,
    .js .demo[data-intro]:not(.is-chosen) .demo__main * {
      visibility: hidden !important;
    }

    .demo__side {
      gap: .75rem;
      padding: .85rem;
    }

    /* Both tabs keep the same footprint too, so changing tab moves nothing on the page. */
    .js .demo__panels {
      gap: 0;
    }

    .js .demo__panels > .demo__panel {
      grid-area: 1 / 1;
    }

    .js .demo__panels > .demo__panel:not(.is-active) {
      display: flex;
      visibility: hidden;
    }

    .demo__actions {
      margin-top: auto;
    }
  }

  @container (min-width: 35rem) {
    .demo__case {
      font-size: .88rem;
    }
  }

  /* ---- played: each part arrives in turn --------------------------------------- */
  /* Before the script answers, the parts wait hidden; if it never does, they show. */
  @media (prefers-reduced-motion: no-preference) {
    .js .demo:not(.is-ready) [data-step] {
      animation: demo-in .5s 4s both;
    }

    .demo.is-live [data-step] {
      opacity: 0;
    }

    .demo.is-live [data-step].is-on {
      animation: demo-in .55s var(--demo-ease) both;
    }

    /* the choice: the two sides arrive one after the other, then their cases */
    .js .demo[data-intro]:not(.is-chosen) .demo__side {
      animation: demo-in .6s var(--demo-ease) .1s both;
    }

    .js .demo[data-intro]:not(.is-chosen) .demo__side + .demo__side {
      animation-delay: .24s;
    }

    .js .demo[data-intro]:not(.is-chosen) .demo__avatar--poesis img {
      animation: demo-helix .8s var(--demo-ease) both;
    }

    .js .demo[data-intro]:not(.is-chosen) .demo__side-map li {
      animation: demo-in .4s var(--demo-ease) both;
      animation-delay: calc(.55s + var(--i) * .13s);
    }

    /* the request is typed in the message field, key by key, with the caret after the last key */
    /* Only in the case on show: a visible child would show through a hidden case. */
    .demo.is-live .demo__panel.is-active .demo__scene.is-current .demo__typed {
      visibility: visible;
    }

    .demo.is-live .demo__key {
      opacity: 0;
    }

    .demo.is-live .is-typing .demo__key {
      animation: demo-word .01s linear both;
      animation-delay: calc(.25s + var(--i) * 26ms);
    }

    .demo.is-live .demo__key::after {
      content: "";
      position: absolute;
      top: .12em;
      left: 100%;
      width: 2px;
      height: 1.1em;
      border-radius: 1px;
      background: #5eead4;
      opacity: 0;
    }

    .demo.is-live .is-typing .demo__key::after {
      animation: demo-caret 26ms linear both;
      animation-delay: calc(.25s + var(--i) * 26ms);
    }

    .demo.is-live .is-typing .demo__key:last-child::after {
      animation-duration: .32s;
    }

    /* then it is sent: the field empties, the button answers, the message joins the conversation */
    .demo.is-live .is-typing .demo__typed {
      animation: demo-sent .22s ease-in var(--type, 2s) both;
    }

    .demo.is-live .is-typing .demo__placeholder {
      animation: demo-word .3s ease-out calc(var(--type, 2s) + .25s) both;
    }

    .demo.is-live .is-typing .demo__send {
      animation: demo-press .32s var(--demo-ease) var(--type, 2s);
    }

    .demo.is-live .demo__row--you.is-on {
      animation-delay: var(--type, 2s);
    }

    /* the answer: the Poesis mark wakes, three dots, then the words, written one after the other */
    .demo.is-live .is-on .demo__avatar--poesis img {
      animation: demo-helix .7s var(--demo-ease) both;
    }

    .demo.is-live .is-on .demo__avatar--poesis::after {
      animation: demo-ring .95s ease-out .1s both;
    }

    .demo.is-live .demo__dots {
      display: inline-flex;
      opacity: 0;
    }

    .demo.is-live .is-on .demo__dots {
      animation: demo-dots .7s linear both;
    }

    .demo.is-live .is-on .demo__dots i {
      animation: demo-dot .7s ease-in-out both;
    }

    .demo.is-live .is-on .demo__dots i:nth-child(2) {
      animation-delay: .12s;
    }

    .demo.is-live .is-on .demo__dots i:nth-child(3) {
      animation-delay: .24s;
    }

    .demo.is-live .demo__word,
    .demo.is-live .demo__flag {
      opacity: 0;
    }

    .demo.is-live .is-on .demo__flag {
      animation: demo-pop .3s var(--demo-ease) .7s both;
    }

    .demo.is-live .is-on .demo__word {
      animation: demo-word .25s ease-out both;
      animation-delay: calc(.75s + var(--i) * 55ms);
    }

    /* the lines of a file or a command, one after the other */
    .demo.is-live .demo__view .demo__line {
      opacity: 0;
    }

    .demo.is-live .demo__view.is-current .demo__line {
      animation: demo-word .3s ease-out both;
      animation-delay: calc(.25s + var(--i) * .2s);
    }

    /* a refusal lands: it arrives, then shakes its head once */
    .demo.is-live .demo__view.is-current .demo__line--refused {
      animation: demo-in .35s var(--demo-ease) .25s both, demo-nope .45s ease-in-out .65s;
    }

    .demo.is-live .demo__view.is-current .demo__line--refused ~ .demo__line {
      animation-delay: 1.25s;
    }

    /* the experts of a panel take their seat one by one, each with its packet written */
    .demo.is-live .demo__view .demo__seat,
    .demo.is-live .demo__view .demo__seat .demo__icon {
      opacity: 0;
    }

    .demo.is-live .demo__view.is-current .demo__seat {
      animation: demo-in .3s var(--demo-ease) both;
      animation-delay: calc(.3s + var(--j) * .2s);
    }

    .demo.is-live .demo__view.is-current .demo__seat .demo__icon {
      animation: demo-pop .3s var(--demo-ease) both;
      animation-delay: calc(.55s + var(--j) * .2s);
    }

    .demo.is-live .demo__view.is-current .demo__line--roster ~ .demo__line {
      animation-delay: 1.7s;
    }

    /* a gate: the question, the answers, then the one a person gives, then what records it */
    .demo.is-live .demo__view .demo__answer.is-chosen::before,
    .demo.is-live .demo__view .demo__answer .demo__icon {
      opacity: 0;
    }

    .demo.is-live .demo__view.is-current .demo__answer.is-chosen::before {
      animation: demo-word .3s ease-out 1.25s both;
    }

    .demo.is-live .demo__view.is-current .demo__answer .demo__icon {
      animation: demo-pop .35s var(--demo-ease) 1.3s both;
    }

    .demo.is-live .demo__view.is-current .demo__line--choice ~ .demo__line {
      animation-delay: 1.85s;
    }

    /* between two cases: the next one fills up */
    .demo.is-live .demo__case.is-next::before {
      animation: demo-fill 5.2s linear both;
    }

    /* held: by the visitor, or while the panel is off screen */
    .demo.is-paused *,
    .demo.is-paused *::before,
    .demo.is-paused *::after,
    .demo.is-held *,
    .demo.is-held *::before,
    .demo.is-held *::after {
      animation-play-state: paused !important;
    }

    /* shown at once: a step chosen by hand never replays its entrance */
    .demo.is-instant *,
    .demo.is-instant *::before,
    .demo.is-instant *::after {
      animation-duration: .01s !important;
      animation-delay: 0s !important;
    }
  }

  /* Reduced motion: states change at once, without a fade. */
  @media (prefers-reduced-motion: reduce) {
    .demo *,
    .demo *::before,
    .demo *::after {
      transition: none !important;
    }
  }

  @keyframes demo-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes demo-word {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes demo-dots {
    0%, 82% { opacity: 1; }
    100% { opacity: 0; }
  }

  @keyframes demo-dot {
    0%, 100% { transform: none; opacity: .45; }
    40% { transform: translateY(-3px); opacity: 1; }
  }

  @keyframes demo-pop {
    from { opacity: 0; transform: scale(.4); }
    to { opacity: 1; transform: none; }
  }

  @keyframes demo-caret {
    0% { opacity: 0; }
    1%, 99% { opacity: 1; }
    100% { opacity: 0; }
  }

  @keyframes demo-sent {
    from { opacity: 1; transform: none; }
    to { opacity: 0; transform: translateY(-6px); }
  }

  @keyframes demo-press {
    0%, 100% { transform: none; }
    45% { transform: scale(.86); }
  }

  @keyframes demo-nope {
    0%, 100% { transform: none; }
    25% { transform: translateX(-5px); }
    60% { transform: translateX(4px); }
  }

  @keyframes demo-helix {
    from { opacity: .4; transform: rotate(-70deg) scale(.6); }
    to { opacity: 1; transform: none; }
  }

  @keyframes demo-ring {
    from { opacity: .9; transform: none; }
    to { opacity: 0; transform: scale(1.45); }
  }

  @keyframes demo-fill {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
</style>
